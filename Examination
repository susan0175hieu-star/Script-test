            pcall(function()
                if not autoQteEnabled or not textLabel:IsA("TextLabel") then return end
                if not textLabel.Visible or textLabel.TextTransparency >= 0.3 then return end
                
                -- ✅ RELAXED SAFETY CHECK: Chỉ skip nếu THỰC SỰ trong finisher animation
