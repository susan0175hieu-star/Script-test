-- Shared Raycast Parameters
local globalRayParams = RaycastParams.new()
globalRayParams.FilterType = Enum.RaycastFilterType.Exclude
globalRayParams.IgnoreWater = true

local function checkPartVisibility(part, targetModel, myChar)
    if not part then return false end

    -- 1. PRIMARY CHECK: FROM CAMERA
    local origin = Camera.CFrame.Position
    local tPos = part.Position
    local direction = (tPos - origin)

    local currentFilter = {myChar, Camera}
    local passedCameraCheck = false

    -- Function to perform a single raycast check with filter
    local function performRaycast(startPos, endPos, filterList)
        local dir = (endPos - startPos)
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = filterList
        rayParams.IgnoreWater = true
        
        local result = workspace:Raycast(startPos, dir, rayParams)
        if not result then return true end
        
        local hit = result.Instance
        local isPartOfChar = hit:IsDescendantOf(targetModel)
        
        if isPartOfChar or hit == part then return true end

        -- Shield Check
        local lowerName = string.lower(hit.Name)
        if string.find(lowerName, "shield") or string.find(lowerName, "khiên") then 
            if isPartOfChar then return true end
        end

        -- Transparency/Collision Pass-through
        if hit.Transparency > 0.7 or not hit.CanCollide then
            -- Recursively ignore this part for this specific check (simplified by just returning fail here to avoid infinite loops in simple implementation, 
            -- or better, we add to filter and retry. For simplicity/perf in this fallback logic, we can try adding to filter)
            return false, hit 
        end

        return false
    end

    -- Standard Camera Iteration (Existing Logic)
    for i = 1, 4 do 
        globalRayParams.FilterDescendantsInstances = currentFilter
        local result = workspace:Raycast(origin, direction, globalRayParams)

        if not result then 
            passedCameraCheck = true 
            break 
        end

        local hit = result.Instance
        local isPartOfChar = hit:IsDescendantOf(targetModel)
        local lowerName = string.lower(hit.Name)

        if isPartOfChar or hit == part or (string.find(lowerName, "shield") and isPartOfChar) then 
            passedCameraCheck = true
            break
        end

        if hit.Transparency > 0.7 or not hit.CanCollide then
            table.insert(currentFilter, hit)
        else
            passedCameraCheck = false
            break
        end
    end

    if passedCameraCheck then return true, tPos end

    -- 2. SECONDARY CHECK: FROM CHARACTER HEAD (Fix for Wall Clipping)
    -- If Camera is blocked (e.g. wall behind character), check if the CHARACTER receives line of sight
    if myChar then
        local myHead = myChar:FindFirstChild("Head")
        if myHead then
            local headOrigin = myHead.Position
            local headDir = (tPos - headOrigin)
            
            -- Reuse filter but reset strictness slightly or keep adding
            local headFilter = {myChar, Camera}
            
            -- Simple single-pass or limited multi-pass for Head
            for i = 1, 3 do
                globalRayParams.FilterDescendantsInstances = headFilter
                local result = workspace:Raycast(headOrigin, headDir, globalRayParams)
                
                if not result then return true, tPos end
                
                local hit = result.Instance
                local isPartOfChar = hit:IsDescendantOf(targetModel)
                local lowerName = string.lower(hit.Name)

                if isPartOfChar or hit == part or (string.find(lowerName, "shield") and isPartOfChar) then 
                    return true, tPos
                end
                
                if hit.Transparency > 0.7 or not hit.CanCollide then
                    table.insert(headFilter, hit)
                else
                    return false
                end
            end
        end
    end

    return false
end

