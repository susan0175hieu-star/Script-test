-- 1. Player ESP
local espEnabled = false
local espContainer = Instance.new("Folder")
espContainer.Name = "ExaminationESP"
espContainer.Parent = CoreGui

local function clearESP() espContainer:ClearAllChildren() end

local function addESP(player)
    if player == LocalPlayer then return end
    
    local function setupChar(char)
        if not espEnabled then return end
        if char == LocalPlayer.Character then return end
        if char:FindFirstChild("ESPHighlight") then return end
        
        local hl = Instance.new("Highlight")
        hl.Name = "ESPHighlight"
        hl.Adornee = char
        hl.FillColor = Color3.fromRGB(0, 255, 255)
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.FillTransparency = 0.5
        hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop -- Force visibility through walls/distance
        hl.Parent = espContainer
        
        char.AncestryChanged:Connect(function()
            if not char:IsDescendantOf(game) then hl:Destroy() end
        end)
    end
    
    if player.Character then setupChar(player.Character) end
    player.CharacterAdded:Connect(setupChar)
end

createToggle(VisualsTab, "Player ESP", false, function(state)
    espEnabled = state
    if state then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then addESP(plr) end
        end
        Players.PlayerAdded:Connect(function(plr)
            if espEnabled and plr ~= LocalPlayer then addESP(plr) end
        end)
    else
        clearESP()
    end
end)

-- 2. Infect ESP (Enemies) - Optimized Distance Limit
local infectEspEnabled = false
local infectEspContainer = Instance.new("Folder")
infectEspContainer.Name = "InfectESP"
infectEspContainer.Parent = CoreGui

-- Track Potential Enemies for ESP
local potentialEspTargets = {} 

local function clearInfectESP() 
    infectEspContainer:ClearAllChildren() 
    -- Manual Cleanup because Highlights are now parented to Models
    for model, _ in pairs(potentialEspTargets) do
        if model and model:FindFirstChild("InfectHighlight") then
             model.InfectHighlight:Destroy()
        end
    end
    potentialEspTargets = {}
end

local function manageInfectHighlights()
    while infectEspEnabled do
        if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            task.wait(1)
            continue
        end
        
        local myPos = LocalPlayer.Character.HumanoidRootPart.Position
        
        for model, _ in pairs(potentialEspTargets) do
            if not model.Parent then 
                potentialEspTargets[model] = nil 
                continue 
            end
            
            local root = model:FindFirstChild("HumanoidRootPart")
            local humanoid = model:FindFirstChildOfClass("Humanoid")
            
            -- SKIP DEAD/INVALID
            if not root or not humanoid or humanoid.Health <= 0 or humanoid:GetState() == Enum.HumanoidStateType.Dead then
                local highlight = model:FindFirstChild("InfectHighlight")
                if highlight then highlight:Destroy() end
                continue
            end

            if root then
                local dist = (root.Position - myPos).Magnitude
                local highlight = model:FindFirstChild("InfectHighlight")
                
                if dist < 150 then -- Only highlight if closer than 150 studs
                    if not highlight then
                        -- Create Highlight
                        local hl = Instance.new("Highlight")
                        hl.Name = "InfectHighlight"
                        hl.Adornee = model
                        hl.FillColor = Color3.fromRGB(255, 0, 0)
                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                        hl.FillTransparency = 0.5
                        hl.OutlineTransparency = 0
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Parent = model -- PARENT TO MODEL so FindFirstChild works!
                        
                        -- No need for complex cleanup since parent is model
                    end
                else
                    -- Too far, remove highlight to save rendering slots
                    if highlight then highlight:Destroy() end
                end
            end
        end
        task.wait(0.2) -- Check 5 times a second
    end
end

local function addInfectESP(model)
    if not infectEspEnabled then return end
    if model == LocalPlayer.Character or model.Name == LocalPlayer.Name then return end
    if Players:GetPlayerFromCharacter(model) then return end
    
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    if Camera.CameraSubject == humanoid then return end

    -- SMART FILTER (Event-Driven)
    local root = model:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local function isValidEnemy()
        -- 1. Has weapon? ALWAYS Valid.
        if model:FindFirstChildOfClass("Tool") then return true end
        -- 2. Anchored? INVALID (Statue) until unanchored.
        if root.Anchored then return false end
        return true
    end

    local function tryAdd()
        if isValidEnemy() then
            -- Check duplicates
            if not potentialEspTargets[model] then
                potentialEspTargets[model] = true
                -- Cleanup listener if it became valid
                -- (Note: In a full event system we'd disconnect specific listeners, but this is simple enough)
            end
        end
    end

    if isValidEnemy() then
        tryAdd()
    else
        -- It's currently a "Statue" or "Spawning". Listen for state changes.
        -- 1. Watch for Unanchoring (Movement allowed)
        local anchorConn
        anchorConn = root:GetPropertyChangedSignal("Anchored"):Connect(function()
            if not root.Anchored then
                tryAdd()
                if anchorConn then anchorConn:Disconnect() anchorConn = nil end
            end
        end)
        
        -- 2. Watch for Weapon Equip
        local toolConn
        toolConn = model.ChildAdded:Connect(function(child)
            if child:IsA("Tool") then
                tryAdd()
                if toolConn then toolConn:Disconnect() toolConn = nil end
            end
        end)
        
        -- Cleanup connections if model dies/removed before becoming valid
        model.AncestryChanged:Connect(function()
            if not model:IsDescendantOf(game) then
                if anchorConn then anchorConn:Disconnect() end
                if toolConn then toolConn:Disconnect() end
            end
        end)
    end
    
    -- Standard Cleanup for valid targets is handled in the main loop or AncestryChanged above
    model.AncestryChanged:Connect(function()
        if not model:IsDescendantOf(game) then 
            potentialEspTargets[model] = nil
        end
    end)
end

createToggle(VisualsTab, "Infect ESP", false, function(state)
    infectEspEnabled = state
    if state then
        -- Collect existing
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
                addInfectESP(obj)
            end
        end
        -- Listen for new
        workspace.DescendantAdded:Connect(function(obj)
            if infectEspEnabled and obj:IsA("Model") then
                task.wait(0.1)
                if obj:FindFirstChildOfClass("Humanoid") then addInfectESP(obj) end
            end
        end)
        -- Start Management Loop
        task.spawn(manageInfectHighlights)
    else
        clearInfectESP()
    end
end)

