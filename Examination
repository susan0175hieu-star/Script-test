    -- HELPER: Shield Detection (Keep as it checks parts, not just names)
    local function isShieldEntity(model)
        if not model then return false end
        for _, child in ipairs(model:GetDescendants()) do
            if child:IsA("BasePart") or child:IsA("Model") then
                local cn = string.lower(child.Name)
                if string.find(cn, "shield") or string.find(cn, "riot") then 
                    -- Ignore face shield/glass
                    if not (string.find(cn, "face") or string.find(cn, "glass")) then
                        return true 
                    end
                end
            end
        end
        return false
    end
    -- HELPER: Check if Player is Infected
    local function isPlayerInfected(plr)
        if not plr then return false end

        -- 1. TEAM CHECK
        local team = plr.Team
        if team then
            local tn = string.lower(team.Name)
            if string.find(tn, "infect") or string.find(tn, "monster") or string.find(tn, "zombie") or string.find(tn, "vật thí nghiệm") then
                return true
            end
        end

        -- 2. TOOL/MARKER CHECK
        local char = plr.Character
        if char then
            local cName = string.lower(char.Name)
            if string.find(cName, "classless") or string.find(cName, "viral") then return true end

            if char:FindFirstChild("Infected") or char:FindFirstChild("Claw") or char:FindFirstChild("Bite") then return true end
            -- Recursive tool check for "Claw", "Bite", or known Infected Weapons
            for _, child in ipairs(char:GetChildren()) do
                if child:IsA("Tool") or child:IsA("Model") then -- Some weapons might be Models
                    local n = string.lower(child.Name)
                    if n == "claw" or n == "bite" or n == "infect" or n == "attack" or n == "viralmaul" or n == "beanbag" or n == "mp5infected" then return true end
                end
            end
        end

        return false
    end

    -- 1. Enemy Tracker (Smart Scanner)
    local function addEnemy(model)
        if model == LocalPlayer.Character then return end
        local plr = Players:GetPlayerFromCharacter(model)
        if not model:FindFirstChildOfClass("Humanoid") then return end
        if isNPCBlacklisted(model.Name) then return end
        if table.find(validEnemies, model) then return end
        
        -- [ SAFETY CHECK: CRITICAL GAME OBJECTS ]
        -- Ignore cutscene props, tapes, and system models to prevent game script crashes
        local n = string.lower(model.Name)
        if string.find(n, "tape") or string.find(n, "intro") or string.find(n, "cutscene") or string.find(n, "sequence") then 
            return 
        end
        -- STATUE/MAP FILTER
        local root = model:FindFirstChild("HumanoidRootPart")
        local isSleeping = false
        local lowName = string.lower(model.Name)
        for _, sName in ipairs({"mikhail", "gilbert", "chimera", "lurker", "riser", "slasher", "rif"}) do
            if string.find(lowName, sName) then isSleeping = true; break end
        end

        local parentName = model.Parent and string.lower(model.Parent.Name) or ""
        local isMapObject = string.find(parentName, "decor") or string.find(parentName, "map") or string.find(parentName, "statue") or string.find(parentName, "prop")

        if root and (root.Anchored or isMapObject) and not isSleeping then return end

        -- PRE-CACHE METADATA (Strict Player/NPC Separation)
        local metadata = nil

        if plr then
            return -- [ ACTIVE PLAYER PROTECTION ] Only protect real, currently active player characters
        end

        -- [ AIM AT EVERYTHING ELSE ]
        -- If it's an NPC/Monster (even if it was a player), we aim.
        local targetData = getTargetData(model.Name)
        if targetData then
            metadata = {
                isMutant = targetData.isMutant or false,
                isBoss = targetData.isBoss or false,
                isShield = isShieldEntity(model),
                elite = targetData.elite or false,
                ignoreHealth = targetData.ignoreHealth or false
            }
        else
            -- Check if it looks like an infected/viral model even if not in list
            if string.find(lowName, "viral") or string.find(lowName, "infect") or string.find(lowName, "mutant") then
                metadata = { isMutant = true, isBoss = false, isShield = false, elite = false }
            else
                return -- Skip unknown props/objects
            end
        end

        table.insert(validEnemies, model)
        entityCache[model] = metadata
        model.AncestryChanged:Connect(function()
            if not model:IsDescendantOf(game) then
                local index = table.find(validEnemies, model)
                if index then table.remove(validEnemies, index) end
                entityCache[model] = nil -- Clean up cache too
            end
        end)
    end

