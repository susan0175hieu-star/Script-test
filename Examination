    -- 2. Infect ESP (Enemies) - Optimized Distance Limit
    local infectEspEnabled = false
    local infectEspContainer = Instance.new("Folder")
    infectEspContainer.Name = "InfectESP"
    infectEspContainer.Parent = CoreGui

    -- Track Potential Enemies for ESP
    local potentialEspTargets = {} 

    local function clearInfectESP() 
        infectEspContainer:ClearAllChildren() 
        -- Manual Cleanup because Highlights are now parented to Models
        for model, _ in pairs(potentialEspTargets) do
            if model and model:FindFirstChild("InfectHighlight") then
                model.InfectHighlight:Destroy()
            end
        end
        potentialEspTargets = {}
    end

    local function manageInfectHighlights()
        local printedBossDebug = {} -- Debounce for debug prints
        
        while infectEspEnabled do
            if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                task.wait(1)
                continue
            end
            
            local myPos = LocalPlayer.Character.HumanoidRootPart.Position
            
            for model, _ in pairs(potentialEspTargets) do
            if not model.Parent or not model:IsDescendantOf(workspace) then 
                potentialEspTargets[model] = nil 
                local highlight = model:FindFirstChild("InfectHighlight")
                if highlight then pcall(function() highlight:Destroy() end) end
                continue 
            end

            -- STRICT FAILSAFE: Remove Self and Players (Players are handled by Player ESP)
            local isPlr = Players:GetPlayerFromCharacter(model)
            if model == LocalPlayer.Character or model.Name == LocalPlayer.Name or isPlr then
                potentialEspTargets[model] = nil
                local highlight = model:FindFirstChild("InfectHighlight")
                if highlight then pcall(function() highlight:Destroy() end) end
                continue
            end
                
                local root = model:FindFirstChild("HumanoidRootPart")
                -- Prioritize Living Humanoid (Fix for Resurrection/Duplicate Humanoids)
                local humanoid = nil
                local firstHum = nil
                for _, child in ipairs(model:GetChildren()) do
                    if child:IsA("Humanoid") then
                        if not firstHum then firstHum = child end
                        if child.Health > 0 then
                            humanoid = child
                            break
                        end
                    end
                end
                humanoid = humanoid or firstHum
                
                -- SKIP DEAD/INVALID 
            local velocityMag = root and root.Velocity.Magnitude or 0
            local isDead = (humanoid.Health <= 0) or (humanoid:GetState() == Enum.HumanoidStateType.Dead) or (humanoid.Parent == nil)
            
            -- NEW: Downed/Ragdoll Check (Keep ESP during pushes/knockdowns)
            local modelName = string.lower(model.Name)
            local isSleeping = false
            for _, name in ipairs(sleepingEnemies) do
                if string.find(modelName, name) then isSleeping = true break end
            end

            local isDowned = humanoid.PlatformStand or 
                            (humanoid:GetState() == Enum.HumanoidStateType.FallingDown) or 
                            (humanoid:GetState() == Enum.HumanoidStateType.Ragdoll) or
                            (humanoid:GetState() == Enum.HumanoidStateType.Physics)

            -- SKIP DEAD/INVALID (Priority Logic)
            if isDead then
                local highlight = model:FindFirstChild("InfectHighlight")
                if highlight then pcall(function() highlight:Destroy() end) end
                
                -- Remove from tracking list if settled (no longer moving)
                if velocityMag < 1 then
                    potentialEspTargets[model] = nil
                end
                continue
            end

                if root then
                    local dist = (root.Position - myPos).Magnitude
                    
                    -- Distance Sanity Check (Don't remove Boss/Whitelisted ESP even if close)
                    if not (isBoss or isSleeping) and dist < 2 then 
                        potentialEspTargets[model] = nil 
                        local highlight = model:FindFirstChild("InfectHighlight")
                        if highlight then highlight:Destroy() end
                        continue
                    end

                    -- GET CACHED METADATA
                    local meta = entityCache[model]
                    local isBoss = meta and meta.isBoss or false
                    local isElite = meta and meta.elite or false

                    local maxDist = isBoss and 2000 or 150 -- Bosses have near infinite range

                    local highlight = model:FindFirstChild("InfectHighlight")
                    
                    if dist < maxDist then
                        local hl = highlight
                        if not hl then
                            -- Create Highlight
                            hl = Instance.new("Highlight")
                            hl.Name = "InfectHighlight"
                            hl.Adornee = model
                            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                            hl.FillTransparency = 0.85
                            hl.OutlineTransparency = 0
                            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            hl.Parent = model
                        end

                        -- DYNAMIC STYLE UPDATE (Boss = Purple, Elite = Orange, Default = Red Outline)
                        if isBoss then
                            hl.FillColor = Color3.fromRGB(130, 0, 255)
                            hl.OutlineColor = Color3.fromRGB(200, 100, 255)
                            hl.FillTransparency = 1 -- Outline only
                        elseif isElite then
                            hl.FillColor = Color3.fromRGB(255, 140, 0) -- Orange
                            hl.OutlineColor = Color3.fromRGB(255, 200, 0) -- Brighter Orange Outline
                            hl.FillTransparency = 1 -- Outline only
                        else
                            hl.FillColor = Color3.fromRGB(255, 0, 0)
                            hl.OutlineColor = Color3.fromRGB(255, 0, 0)
                            hl.FillTransparency = 1 -- Outline only
                        end
                    else
                        -- Too far, remove highlight to save rendering slots
                        if highlight then highlight:Destroy() end
                    end
                end
            end
            task.wait(0.1) -- Fast Update (10 times a second for instant kill feedback)
        end
    end

    local function addInfectESP(model)
        if not infectEspEnabled then return end
    if model == LocalPlayer.Character or model.Name == LocalPlayer.Name then return end
    if Players:GetPlayerFromCharacter(model) or Players:FindFirstChild(model.Name) then return end
        
        local humanoid = model:FindFirstChildOfClass("Humanoid")
        if not humanoid then return end
        
        if Camera.CameraSubject == humanoid then return end

        -- SMART FILTER (Event-Driven)
        local root = model:FindFirstChild("HumanoidRootPart")
        if not root then return end

        local function isValidEnemy()
            -- 0. Strict Self Check & Player Check
            if model == LocalPlayer.Character or model.Name == LocalPlayer.Name then return false end
            if Players:GetPlayerFromCharacter(model) or Players:FindFirstChild(model.Name) then return false end

            -- 0.1 Name Blacklist (Prop filter)
            if isNPCBlacklisted(model.Name) then return false end
            
            -- 0.2 Statue/Decoration Filter (IMPORTANT FIX)
            -- Check if it's anchored OR inside a map/decoration folder
            local isSleeping = false
            local lowName = string.lower(model.Name)
            for _, sName in ipairs(sleepingEnemies) do
                if string.find(lowName, sName) then
                    isSleeping = true
                    break
                end
            end

            local parentName = model.Parent and string.lower(model.Parent.Name) or ""
            local isMapObject = string.find(parentName, "decor") or string.find(parentName, "map") or string.find(parentName, "statue") or string.find(parentName, "prop")

            if (root.Anchored or isMapObject) and not isSleeping then 
                return false 
            end
            
            -- 0.3 Target Check (Now safe from statues)
            local targetData = getTargetData(model.Name)
            if targetData then return true end

            -- 1. Default: If it's a valid humanoid NPC (non-player), show it
            return true
        end

        local function tryAdd()
            if isValidEnemy() then
                if not potentialEspTargets[model] then
                    potentialEspTargets[model] = true
                end
            end
        end

        if isValidEnemy() then
            tryAdd()
        else
            -- Listen for state changes (Anchored -> Unanchored)
            local anchorConn
            anchorConn = root:GetPropertyChangedSignal("Anchored"):Connect(function()
                if not root.Anchored then
                    tryAdd()
                    if anchorConn then anchorConn:Disconnect() anchorConn = nil end
                end
            end)
            
            model.AncestryChanged:Connect(function()
                if not model:IsDescendantOf(game) then
                    if anchorConn then anchorConn:Disconnect() end
                end
            end)
        end
        
        -- Standard Cleanup for valid targets is handled in the main loop or AncestryChanged above
        model.AncestryChanged:Connect(function()
            if not model:IsDescendantOf(game) then 
                potentialEspTargets[model] = nil
            end
        end)
    end

    createToggle(VisualsTab, "Infected ESP", false, function(state)
        infectEspEnabled = state
        
        if state then
            -- STAGGERED INITIAL SCAN (Prevents Crash)
            task.spawn(function()
                local allDesc = workspace:GetDescendants()
                local count = 0
                for _, obj in ipairs(allDesc) do
                    if not infectEspEnabled then break end -- Stop if toggled off
                    
                    -- 1. Infected Check
                    if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
                        addInfectESP(obj)
                    end
                    
                    count = count + 1
                    if count >= 300 then -- Process 300 items then pause
                        count = 0
                        task.wait() -- Move to next frame/cycle
                    end
                end
            end)
            -- Start Management Loops
            task.spawn(manageInfectHighlights)
        else
            clearInfectESP()
        end
    end)

