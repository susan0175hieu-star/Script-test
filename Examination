    -- ORIGINAL LOGIC WRAPPER
    local function originalToggleLogic(state)
            getgenv().ThirdPersonUpdate_Active = state
            
            -- Caching physics objects for performance
            local cachedAO = nil
            local cachedAtt = nil
            local charPartsCache = {}
            local lastUpdateFrame = 0
            local frameCounter = 0
            
            -- THREAD-SAFE TARGETING
            local sharedTarget = {P = nil, Pos = nil, S = false}
            local charHRP, charHum = nil, nil
            
            local function updateCharRefs()
                local char = LocalPlayer.Character
                if not char then return end
                charHRP = char:FindFirstChild("HumanoidRootPart")
                charHum = char:FindFirstChildOfClass("Humanoid")
                
                charPartsCache = {}
                for _, obj in ipairs(char:GetDescendants()) do
                    if obj:IsA("BasePart") and obj.Name ~= "Head" then
                        table.insert(charPartsCache, obj)
                    end
                end
            end
            
            local charAddedConn = LocalPlayer.CharacterAdded:Connect(function()
                task.wait(0.5) -- Wait for accessories to load
                updateCharRefs()
            end)
            updateCharRefs()
            
            -- [ BACKGROUND TASK: TRANSPARENCY & AIM SEARCH (30Hz - Optimized) ]
            task.spawn(function()
                local aimSearchCounter = 0 -- ✅ Throttle counter for aim search
                
                while getgenv().ThirdPersonUpdate_Active and ScreenGui.Parent do
                    -- ✅ FIX #2: Transparency with parent validation
                    if charPartsCache then
                        for i = 1, #charPartsCache do
                            local p = charPartsCache[i]
                            if p and p.Parent and p.LocalTransparencyModifier ~= 0 then 
                                p.LocalTransparencyModifier = 0 
                            end
                        end
                    end
                    
                    -- ✅ FIX #3: Throttle aim search (every 3rd iteration = 10Hz)
                    aimSearchCounter = aimSearchCounter + 1
                    if aimSearchCounter % 3 == 0 then
                        if aimEnabled and isAiming and getClosestTarget then
                            local target = getClosestTarget()
                            if target then
                                local head = target:FindFirstChild("Head")
                                local root = target:FindFirstChild("HumanoidRootPart")
                                local aimPart = head or root
                                
                                if aimPart and root then
                                    local vel = root.Velocity
                                    local pos = aimPart.Position + (vel * (aimPrediction or 0.088))
                                    
                                    -- Check cache for shield
                                    local meta = entityCache[target]
                                    local isShield = meta and meta.isShield or false
                                    
                                    sharedTarget.P = aimPart
                                    sharedTarget.Pos = pos
                                    sharedTarget.S = isShield
                                else
                                    sharedTarget.Pos = nil
                                end
                            else
                                sharedTarget.Pos = nil
                            end
                        else
                            sharedTarget.Pos = nil
                        end
                    end
                    
                    task.wait(0.033) -- ✅ FIX #1: 30Hz update rate (was unlimited)
                end
            end)

            local function getPhysicsObjects(char)
                if not char then return nil end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if not hrp then return nil end
                
                if not cachedAO or not cachedAO.Parent or cachedAO.Parent ~= hrp then
                    cachedAtt = hrp:FindFirstChild("TP_Attachment") or Instance.new("Attachment", hrp)
                    cachedAtt.Name = "TP_Attachment"
                    
                    cachedAO = hrp:FindFirstChild("TP_Align") or Instance.new("AlignOrientation", hrp)
                    cachedAO.Name = "TP_Align"
                    cachedAO.Attachment0 = cachedAtt
                    cachedAO.Mode = Enum.OrientationAlignmentMode.OneAttachment
                    cachedAO.RigidityEnabled = false
                    cachedAO.MaxTorque = math.huge
                    cachedAO.MaxAngularVelocity = math.huge
                    cachedAO.Responsiveness = 400
                end
                return cachedAO
            end

            if state then
                -- ENSURE STATIC AIM IS UNBOUND while TP is ON
                RunService:UnbindFromRenderStep("AimBotUpdate_Static")
                
                RunService:BindToRenderStep("ThirdPersonUpdate", Enum.RenderPriority.Camera.Value + 1, function(dt)
                    if not getgenv().ThirdPersonUpdate_Active or not ScreenGui.Parent then 
                        getgenv().ThirdPersonUpdate_Active = false
                        RunService:UnbindFromRenderStep("ThirdPersonUpdate")
                        if charHRP then
                            for _, name in ipairs({"TP_Attachment", "TP_Align"}) do
                                local obj = charHRP:FindFirstChild(name)
                                if obj then obj:Destroy() end
                            end
                        end
                        if charHum then charHum.AutoRotate = true end
                        LocalPlayer.CameraMaxZoomDistance = 0
                        LocalPlayer.CameraMinZoomDistance = 0
                        LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
                        return 
                    end

                    if charHRP and charHum then
                        -- 1. CAMERA (Silky Smooth Lerp)
                        local camCF = Camera.CFrame
                        local camRot = camCF.Rotation
                        -- Fixed Camera Position (No Zoom on Aim)
                        local tX, tY, tD = tpOffsetX, tpOffsetY, 5.0
                        local lerp = 1 - math.exp(-15 * dt)
                        
                        local cX = (getgenv().currentTP_X or tpOffsetX) + (tX - (getgenv().currentTP_X or tpOffsetX)) * lerp
                        local cY = (getgenv().currentTP_Y or tpOffsetY) + (tY - (getgenv().currentTP_Y or tpOffsetY)) * lerp
                        local cD = (getgenv().currentTP_Dist or 5.0) + (tD - (getgenv().currentTP_Dist or 5.0)) * lerp
                        
                        getgenv().currentTP_X, getgenv().currentTP_Y, getgenv().currentTP_Dist = cX, cY, cD
                        Camera.CFrame = CFrame.new(charHRP.Position + (camRot * Vector3.new(cX, cY, cD))) * camRot

                        -- 2. MOUSE LOCK (Every frame for responsiveness)
                        if not freeMouseEnabled then
                            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
                        end

                        -- 3. ROTATION (Fast Physics)
                        local ao = getPhysicsObjects(LocalPlayer.Character)
                        if ao then
                            charHum.AutoRotate = false
                            local lookV = camRot.LookVector
                            ao.CFrame = CFrame.lookAt(Vector3.zero, Vector3.new(lookV.X, 0, lookV.Z).Unit)
                        end

                        -- 4. AIMBOT SMOOTHING (Interpolate only)
                        if aimEnabled and isAiming and sharedTarget.Pos then
                            local offX = 0 -- Center (Chính xác tuyệt đối)
                            local offY = 0 -- Center (Chính xác tuyệt đối vào tâm Đầu)
                            local finalPos = sharedTarget.Pos + (camRot.RightVector * offX) + (Vector3.new(0, 1, 0) * offY)
                            Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, finalPos), 0.25)
                        end
                        
                        -- 5. ENGINE PROPERTIES (Throttled)
                        frameCounter = (frameCounter + 1) % 15
                        if frameCounter == 0 then
                            LocalPlayer.CameraMaxZoomDistance = 5.0
                            LocalPlayer.CameraMinZoomDistance = 5.0
                            LocalPlayer.CameraMode = Enum.CameraMode.Classic
                            LocalPlayer.DevCameraOcclusionMode = Enum.DevCameraOcclusionMode.Zoom
                        end
                    end
                end)
            else
                -- CLEANUP
                if charAddedConn then charAddedConn:Disconnect() end
                RunService:UnbindFromRenderStep("ThirdPersonUpdate")

                if LocalPlayer.Character then
                    local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                    if hrp then
                        for _, name in ipairs({"TP_Attachment", "TP_Align"}) do
                            local obj = hrp:FindFirstChild(name)
                            if obj then obj:Destroy() end
                        end
                    end
                    if hum then
                        hum.AutoRotate = true
                        Camera.CameraSubject = hum
                    end
                end
                LocalPlayer.CameraMaxZoomDistance = 0
                LocalPlayer.CameraMinZoomDistance = 0
                LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
            end
    end

