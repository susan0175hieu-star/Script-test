                        end
                        
                        table.insert(velocityHistory, root.Velocity)
                        if #velocityHistory > maxHistory then table.remove(velocityHistory, 1) end
                        
                        local avgVel = Vector3.new()
                        for _, v in ipairs(velocityHistory) do avgVel = avgVel + v end
                        avgVel = avgVel / #velocityHistory
                        
                        -- Dynamic Lerp for Smoothing
                        -- If we just acquired the target (history is building), SNAP to the average (Factor 1.0)
                        -- If we have a stable track, use smoothing (Factor 0.65)
