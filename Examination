                    local keywords = {"mod", "admin", "staff", "dev", "helper", "owner"}
                    local name = string.lower(player.Name)
                    local display = string.lower(player.DisplayName)
                    local isCreator = (player.UserId == game.CreatorId)
                    
                    local matchesKeyword = false
                    for _, kw in ipairs(keywords) do
                        if string.find(name, kw) or string.find(display, kw) then
                            matchesKeyword = true
                            handleStaffDetection(player, "Keyword Match: " .. kw)
                            break
                        end
                    end
                    
                    if isCreator and not matchesKeyword then
                        handleStaffDetection(player, "Game Creator")
                    end
                    
                    if isCreator or matchesKeyword then return end

