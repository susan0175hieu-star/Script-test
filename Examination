            end
        end

        if not currentTargetPart then
            local detailParts = {"RightUpperArm", "LeftUpperArm", "RightLowerArm", "LeftLowerArm", "RightLowerLeg", "LeftLowerLeg"}
            for _, name in ipairs(detailParts) do
                local part = character:FindFirstChild(name)
                local vis, pos = checkPartVisibility(part, character, char, globalRayParams)
                if vis then 
                    currentTargetPart, currentLockedPos = part, pos
                    lastTargetPart = name -- Save for next frame
                    break 
                end
            end
        end

        -- Valid Target Found? Return immediately (Snap to it!)
        if currentTargetPart then
            local isFacingAway = (cand.root.CFrame.LookVector:Dot(Camera.CFrame.LookVector) > 0.6)
            
            -- DYNAMIC SHIELD BYPASS: Disable offset if downed OR facing away
            local hum = cand.humanoid
            local root = cand.root
            local head = character:FindFirstChild("Head")
            local hDiff = head and math.abs(head.Position.Y - root.Position.Y) or 5
            
            -- PUSH MEMORY: If spinning (> 5) or pushed (> 15), treat as vulnerable for 0.6s
            if cand.root.RotVelocity.Magnitude > 5 or cand.root.Velocity.Magnitude > 15 then meta.lastPushTime = tick() end
            local isRecentlyPushed = (tick() - (meta.lastPushTime or 0) < 0.6)

            -- Optimized Prone Detection: Shielders keep offset unless truly flat on ground
            local isCurrentlyProne = hum.PlatformStand or (hum:GetState() == Enum.HumanoidStateType.FallingDown) or (hum:GetState() == Enum.HumanoidStateType.Ragdoll) or (hum:GetState() == Enum.HumanoidStateType.Physics) or (hum.Sit) or (root.CFrame.UpVector.Y < 0.4) or (hDiff < 0.8)
            
            -- Taunt/Shield Bang Fix: Don't count "Stunned" or "Push" states as prone if the shielder is still upright
            local stunMarker = character:FindFirstChild("Stunned") or character:FindFirstChild("Stun") or isRecentlyPushed
            if stunMarker and not (meta.isShield and hDiff > 1.1) then
                isCurrentlyProne = true
            end

            if isCurrentlyProne then meta.lastProneTime = tick() end
            
            local isProne = (tick() - (meta.lastProneTime or 0) < 0.2) -- Match recovery time
            local shouldApplyOffset = meta.isShield and not (isProne or isFacingAway)

            -- Persistence Update
            lastTarget = character
            lastTargetTime = tick()

            return currentTargetPart, currentLockedPos, shouldApplyOffset, cand.root.Velocity, currentTargetPart.Name, meta.isHighMob, isFacingAway, character
        end
    end

    -- PASS 3: Target Persistence (Grace Period for Bosses/Active Targets)
    -- If we lost the target due to teleport/jump, try to find it again for 0.5s
    if lastTarget and lastTarget.Parent and (tick() - lastTargetTime < 0.5) then
        local character = lastTarget
        local root = character:FindFirstChild("HumanoidRootPart")
        local hum = character:FindFirstChildOfClass("Humanoid")

        if root and hum and hum.Health > 0 then
            local meta = entityCache[character] or {isBoss = isBossEntity(character)}
            
            -- For bosses, we allow "loose" tracking (check more parts if needed)
            local targets = {"Head", "UpperTorso", "HumanoidRootPart", "LowerTorso", "RightUpperArm", "LeftUpperArm"}
            for _, name in ipairs(targets) do
                local p = character:FindFirstChild(name)
                if p then
                    local vis, pos = checkPartVisibility(p, character, char, globalRayParams)
                    if vis or meta.isBoss then -- Bosses can be tracked even if occluded for 0.5s
                        -- DYNAMIC SHIELD BYPASS (Persistence): Disable offset if downed
                        local headPos = character:FindFirstChild("Head") and character.Head.Position.Y or 0
                        local hDiff = math.abs(headPos - root.Position.Y)
                        -- PUSH MEMORY (Persistence)
                        if root.RotVelocity.Magnitude > 5 or root.Velocity.Magnitude > 15 then meta.lastPushTime = tick() end
                        local isRecentlyPushed = (tick() - (meta.lastPushTime or 0) < 0.6)

                        -- Persistence Logic Fix: Apply the same refined prone check
                        local isCurrentlyProne = hum.PlatformStand or (hum:GetState() == Enum.HumanoidStateType.FallingDown) or (hum:GetState() == Enum.HumanoidStateType.Ragdoll) or (hum:GetState() == Enum.HumanoidStateType.Physics) or (hum.Sit) or (root.CFrame.UpVector.Y < 0.4) or (hDiff < 0.8)
                        local stunMarker = character:FindFirstChild("Stunned") or character:FindFirstChild("Stun") or isRecentlyPushed
                        if stunMarker and not (meta.isShield and hDiff > 1.1) then
                            isCurrentlyProne = true
                        end
                        
                        if isCurrentlyProne then meta.lastProneTime = tick() end
                        
                        local isProne = (tick() - (meta.lastProneTime or 0) < 0.5)
                        local shouldApplyOffset = meta.isShield and not isProne
                        
                        return p, pos or p.Position, shouldApplyOffset, root.Velocity, p.Name, meta.isHighMob, false, character
                    end
                end
            end
        end
    end

    return nil
end

