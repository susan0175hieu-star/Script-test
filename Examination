                -- [ ANTI-STAFF LOGIC ]
                local function detectStaff(player)
                    if not player or player == LocalPlayer then return false end
                    
                    -- 1. Creator Check
                    if player.UserId == game.CreatorId and game.CreatorType == Enum.CreatorType.User then
                        return true, "Game Creator"
                    end
                    
                    -- 2. Group Rank Check
                    if antiStaffGroupId > 0 then
                        local s, rank = pcall(function() return player:GetRankInGroup(antiStaffGroupId) end)
                        if s and rank >= 200 then -- Most games use 200+ for staff
                            return true, "Group Staff (Rank " .. rank .. ")"
                        end
                    end
                    
                    -- 3. Name/Display Name Keywords
                    local keywords = {"mod", "admin", "staff", "dev", "helper", "owner"}
                    local name = string.lower(player.Name)
                    local display = string.lower(player.DisplayName)
                    
                    for _, kw in ipairs(keywords) do
                        if string.find(name, kw) or string.find(display, kw) then
                            return true, "Keyword Match: " .. kw
                        end
                    end
                    
                    return false
                end

                local function handleStaffDetection(player, reason)
                    if not antiStaffEnabled then return end
                    if detectedStaff[player.UserId] then return end
                    detectedStaff[player.UserId] = true
                    
                    if antiStaffAutoLeave then
                        LocalPlayer:Kick("\nCó Staff vào kiểm tra. Nên Script tự Kick bạn ra server")
                    else
                        -- Visual Alert if not auto-leaving
                        if pcall(function()
                            game:GetService("StarterGui"):SetCore("SendNotification", {
                                Title = "!!! STAFF DETECTED !!!",
                                Text = player.Name .. " is a " .. reason,
                                Duration = 10,
                                Button1 = "Leave Now"
                            })
                        end) then end
                    end
                end

