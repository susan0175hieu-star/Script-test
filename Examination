                        task.wait(1)
                        checkDeep(plr)
                    end)
                    table.insert(antiStaffConnections, conn)
                end)
                table.insert(antiStaffConnections, addedConn)

                -- 3. Periodic Background Check (Failsafe)
                task.spawn(function()
