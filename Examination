                local velocityMag = root and root.Velocity.Magnitude or 0
                local isDead = (humanoid.Health <= 0) or (humanoid:GetState() == Enum.HumanoidStateType.Dead) or (humanoid.Parent == nil)
                
                -- SKIP DEAD/INVALID
                if isDead and not isFriendlyNPC then
                    local highlight = model:FindFirstChild("InfectHighlight")
                    if highlight then pcall(function() highlight:Destroy() end) end
                    
                    if (not meta or not meta.isBoss) and velocityMag < 1 then 
                        potentialEspTargets[model] = nil 
                    end
                    continue
                end

                if root then
                    local dist = (root.Position - myPos).Magnitude
                    
                    -- Distance Sanity Check
                    if isDead and dist < 2 then 
                        potentialEspTargets[model] = nil 
                        local highlight = model:FindFirstChild("InfectHighlight")
                        if highlight then highlight:Destroy() end
                        continue
                    end

                    local maxDist = (isBoss) and 2000 or 90
                    local highlight = model:FindFirstChild("InfectHighlight")
                    
