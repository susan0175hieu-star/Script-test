local function isPlayerInfected(player)
    if not player or not player.Character then return false end
    local team = player.Team
    if team and (string.find(string.lower(team.Name), "infect") or string.find(string.lower(team.Name), "viral")) then
        return true
    end
    local charName = string.lower(player.Character.Name)
    if string.find(charName, "viral") or string.find(charName, "infect") then
        return true
    end
    return false
end

-- [ ANTI-STAFF LOGIC ]
local function detectStaff(player)
    if not player or player == LocalPlayer then return false end
    
    -- 1. Game Creator
    if player.UserId == game.CreatorId then
        return true, "Game Creator"
    end
    
    -- 2. Name Keywords
    local keywords = {"mod", "admin", "staff", "dev", "helper", "owner"}
    local nameStr = string.lower(player.Name .. player.DisplayName)
    for _, kw in ipairs(keywords) do
        if string.find(nameStr, kw) then
            return true, "Keyword Match: " .. kw
        end
    end
    
    -- 3. Group Rank
    if antiStaffGroupId > 0 then
        local s, rank = pcall(function() return player:GetRankInGroup(antiStaffGroupId) end)
        if s and rank >= 200 then
            return true, "Group Staff (Rank " .. rank .. ")"
        end
    end
    
    return false
end

local function handleStaffDetection(player, reason)
    if not antiStaffEnabled or detectedStaff[player.UserId] then return end
    detectedStaff[player.UserId] = true
    
    if antiStaffAutoLeave then
        LocalPlayer:Kick("\nStaff detected: " .. player.Name .. " (" .. reason .. ")")
    else
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "!!! STAFF DETECTED !!!",
                Text = player.Name .. " is a " .. reason,
                Duration = 10,
                Button1 = "Leave Now"
            })
        end)
    end
end

local function checkPlayerStaff(player)
    task.spawn(function()
        local isStaff, reason = detectStaff(player)
        if isStaff then
            handleStaffDetection(player, reason)
        end
    end)
end

