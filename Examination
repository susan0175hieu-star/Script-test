                    if flyBodyGyro then flyBodyGyro:Destroy() flyBodyGyro = nil end
                    if flyBodyVelocity then flyBodyVelocity:Destroy() flyBodyVelocity = nil end
                    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                        LocalPlayer.Character.Humanoid.PlatformStand = false
                        LocalPlayer.Character.Humanoid.WalkSpeed = walkSpeed -- Restore Speed
                    end
                end

                local function startFly()
                    local char = LocalPlayer.Character
                    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
                    
                    local hrp = char.HumanoidRootPart
                    local humanoid = char:FindFirstChild("Humanoid")
                    
                    if flyBodyGyro or flyBodyVelocity then return end
                    
                    flyBodyGyro = Instance.new("BodyGyro")
                    flyBodyGyro.P = 9e4
                    flyBodyGyro.maxTorque = Vector3.new(9e9, 9e9, 9e9)
                    flyBodyGyro.cframe = hrp.CFrame
                    flyBodyGyro.Parent = hrp
                    
                    flyBodyVelocity = Instance.new("BodyVelocity")
                    flyBodyVelocity.velocity = Vector3.new(0,0.1,0)
                    flyBodyVelocity.maxForce = Vector3.new(9e9, 9e9, 9e9)
                    flyBodyVelocity.Parent = hrp
                    
                    humanoid.PlatformStand = true
                    humanoid.WalkSpeed = 16 -- Reset to default to prevent Camera Tilt from game scripts
                    
                    task.spawn(function()
                        while flyEnabled and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 do
                            if not ScreenGui.Parent then stopFly() break end
                            if not flyBodyGyro or not flyBodyGyro.Parent then break end
                            
                            -- Lock Gyro to Camera LookVector but Keep Upright (Removes Tilt/Roll)
                            flyBodyGyro.cframe = CFrame.lookAt(hrp.Position, hrp.Position + Camera.CFrame.LookVector)
                            
                            local vel = Vector3.new()
                            if UserInputService:IsKeyDown(Enum.KeyCode.W) then vel = vel + Camera.CFrame.LookVector * flySpeed end
                            if UserInputService:IsKeyDown(Enum.KeyCode.S) then vel = vel - Camera.CFrame.LookVector * flySpeed end
                            if UserInputService:IsKeyDown(Enum.KeyCode.D) then vel = vel + Camera.CFrame.RightVector * flySpeed end
                            if UserInputService:IsKeyDown(Enum.KeyCode.A) then vel = vel - Camera.CFrame.RightVector * flySpeed end
                            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vel = vel + Vector3.new(0, 1, 0) * flySpeed end
                            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then vel = vel - Vector3.new(0, 1, 0) * flySpeed end
                            
                            flyBodyVelocity.velocity = vel
                            RunService.RenderStepped:Wait()
                        end
                    end)
                end

                local toggleFly = createToggleInput(LocalTab, "Fly Mode (F)", 50, false, function(val, state)
                    flySpeed = val
                    flyEnabled = state
                    if flyEnabled then startFly() else stopFly() end
                end)

                -- Keybind for Fly (F)
                UserInputService.InputBegan:Connect(function(input, gpe)
                    if gpe then return end
                    if input.KeyCode == Enum.KeyCode.F then
                        toggleFly(nil, not flyEnabled)
                    end
                end)

                -- 3. FullBright
                local fullBrightConnection = nil
                createToggle(VisualsTab, "FullBright", false, function(state)
                    if state then
                        fullBrightConnection = RunService.RenderStepped:Connect(function()
                            if not ScreenGui.Parent then
                                if fullBrightConnection then fullBrightConnection:Disconnect() end
                                return
                            end
                            Lighting.Brightness = 2
                            Lighting.ClockTime = 14
                            Lighting.FogEnd = 100000
                            Lighting.GlobalShadows = false
                            Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
                        end)
                    else
                        if fullBrightConnection then
                            fullBrightConnection:Disconnect()
                            fullBrightConnection = nil
                            Lighting.Brightness = 1
                            Lighting.GlobalShadows = true
                        end
                    end
                end)

                -- 4. Noclip (Walk Through Walls)
                local noclipConnection = nil
                createToggle(LocalTab, "Noclip", false, function(state)
                    if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end
                    
                    if state then
                        noclipConnection = RunService.Stepped:Connect(function()
                            if not ScreenGui.Parent then -- Suicide check
                                if noclipConnection then noclipConnection:Disconnect() end
                                return
                            end
                            
                            local char = LocalPlayer.Character
                            if char then
                                for _, part in ipairs(char:GetDescendants()) do
                                    if part:IsA("BasePart") and part.CanCollide then
                                        part.CanCollide = false
                                    end
                                end
                            end
                        end)
                    else
                        -- RESET COLLISIONS IMMEDIATELY
                        local char = LocalPlayer.Character
                        if char then
                            for _, part in ipairs(char:GetDescendants()) do
                                if part:IsA("BasePart") then
                                    -- WHITELIST: Only restore collision for CORE parts
                                    -- Restoring collision on limbs (Arms/Legs) causes FLING due to self-collision
                                    local restoreList = {
                                        ["Head"] = true,
                                        ["HumanoidRootPart"] = true,
                                        ["Torso"] = true,
                                        ["UpperTorso"] = true,
                                        ["LowerTorso"] = true
                                    }
                                    if restoreList[part.Name] then
                                        part.CanCollide = true
                                    end
                                end
                            end
                        end
                    end
                end)





                -- ====================
                -- CATEGORY: COMBAT
                -- ====================

                local aimEnabled = false
                local aimKey = Enum.UserInputType.MouseButton2
                local aimFOV = 200
                local aimSmoothness = 0.8
                local aimRightOffset = 0.7
                local aimUpOffset = 0.4
                local aimBotDebug = false
                local validEnemies = {}
                local entityCache = {} -- Cache for NPC metadata (Shield, Mutant, etc.)

                -- HELPER: High Mobility Detection (RSU/Gunner Rollers)
                local function isHighMobilityEntity(model)
                    if not model then return false end
                    local n = string.lower(model.Name)
                    local mobileKeywords = {"chimera", "boss", "rsu", "gunner", "lurker", "lab", "scientist", "hazmat", "stalker", "ninja", "agile", "mutant", "subject", "specimen", "research", "hazard", "white", "heavy", "gas", "mask", "tactical", "soldier", "commando", "elite", "guard", "security", "unit", "yellow"}
                    for _, kw in ipairs(mobileKeywords) do
                        if string.find(n, kw) then return true end
                    end
                    return false
                end

                local function isMutantEntity(model)
                    if not model then return false end
                    local n = string.lower(model.Name)
                    if string.find(n, "lab") or string.find(n, "mutant") or string.find(n, "subject") or 
                    string.find(n, "scientist") or string.find(n, "hazmat") or string.find(n, "yellow") or
                    string.find(n, "white") or string.find(n, "gas") or string.find(n, "mask") or
                    string.find(n, "worker") or string.find(n, "engineer") or string.find(n, "helmet") or
                    string.find(n, "heavy") or string.find(n, "specialist") or string.find(n, "red") or
                    string.find(n, "vest") or string.find(n, "armored") or string.find(n, "guard") or
                    string.find(n, "fireriser") or string.find(n, "fire") or string.find(n, "riser") or
                    string.find(n, "A9") or string.find(n, "B9") or string.find(n, "A15") then
                        return true
                    end
                    return false
                end

                -- HELPER: Boss Detection for ESP/Aim
                local function isBossEntity(model)
                    if not model then return false end
                    local n = string.lower(model.Name)
                    if string.find(n, "chimera") or string.find(n, "boss") then return true end
                    
                    -- Check for special boss parts (Claw/Talon)
                    for _, child in ipairs(model:GetChildren()) do
                        if child:IsA("BasePart") or child:IsA("Model") then
                            local cn = string.lower(child.Name)
                            if string.find(cn, "claw") or string.find(cn, "talon") then return true end
                        end
                    end
                    return false
                end

                -- HELPER: Shield Detection for ESP/Aim
                local function isShieldEntity(model)
                    if not model then return false end
                    for _, child in ipairs(model:GetDescendants()) do
                        if child:IsA("BasePart") or child:IsA("Model") then
                            local cn = string.lower(child.Name)
                            -- BLACKLIST: Ignore face shield, gas mask, protective glass
                            if string.find(cn, "face") or string.find(cn, "mask") or string.find(cn, "glass") or string.find(cn, "mặt") then
                                -- Skip
                            elseif string.find(cn, "shield") or string.find(cn, "khiên") or string.find(cn, "riot") then 
                                return true 
                            end
                        end
                    end
                    return false
                end

                -- HELPER: Elite Enemy Detection (Shotgun, Chainsaw, etc.)
                local function isEliteEntity(model)
                    if not model then return false end
                    local n = string.lower(model.Name)
                    if string.find(n, "shotgun") or string.find(n, "chainsaw") or string.find(n, "saw") then return true end
                    
                    -- Check Tool/Weapon name
                    for _, child in ipairs(model:GetChildren()) do
                        if child:IsA("Tool") or child:IsA("Model") or child:IsA("BasePart") then
                            local cn = string.lower(child.Name)
                            if string.find(cn, "shotgun") or string.find(cn, "chainsaw") or string.find(cn, "saw") then
                                return true
                            end
                        end
                    end
                    return false
                end

                -- HELPER: Weapon Detection (Tools + Custom Names)
                local function hasWeapon(char)
                    if not char then return false end
                    
                    -- 0. BOSS NAME CHECK
                    local charName = string.lower(char.Name)
                    if string.find(charName, "chimera") or string.find(charName, "boss") then return true, "BossName" end

                    -- 0.1 BOSS WEAPON CHECK (Priority)
                    for _, child in ipairs(char:GetChildren()) do
                        if child:IsA("BasePart") or child:IsA("Model") then
                            local n = string.lower(child.Name)
                            if string.find(n, "claw") or string.find(n, "talon") or string.find(n, "sting") then return true, "BossPart" end
                        end
                    end

                    -- 1. Standard Tool
                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool then return true, tool.Name end
                    
                    -- 2. Custom Named Parts/Models (e.g. Chainsaw)
                    local weaponKeywords = {
                        "chainsaw", "weapon", "gun", "rifle", "axe", "blade", "knife",
                        "pistol", "revolver", "g17", "m9", "glock",
                        "shotgun", "spas", "remington",
                        "smg", "mp5", "uzi",
                        "sniper", "awp", "barrett",
                        "bow", "crossbow",
                        "sword", "katana", "saber",
                        "claw", "talon", "sting", -- BOSS KEYWORDS
                        "shield", "guard", "defense", -- SHIELD MONSTER KEYWORDS
                        "bite", "scratch", "claw", "fist", "attack" -- MUTANT KEYWORDS
                    }

                    -- Recursive Check (GetDescendants) to find nested weapons
                    for _, child in ipairs(char:GetDescendants()) do
                        if child:IsA("BasePart") or child:IsA("Model") then
                            local name = string.lower(child.Name)
                            
                            -- BLACKLIST: Ignore holsters, pouches, bags
                            if string.find(name, "holster") or string.find(name, "pouch") or string.find(name, "bag") or string.find(name, "sheath") then
                                -- Skip this part (Safe)
                            else
                                -- WHITELIST CHECK
                                for _, keyword in ipairs(weaponKeywords) do
                                    if string.find(name, keyword) then return true, child.Name end
                                end
                            end
                        end
                    end
                    return false
                end

                -- 1. Enemy Tracker (Smart Scanner)
                local function addEnemy(model)
                    if model == LocalPlayer.Character then return end
                    if Players:GetPlayerFromCharacter(model) then return end
                    if not model:FindFirstChildOfClass("Humanoid") then return end
                    if isNPCBlacklisted(model.Name) then return end -- Fix: Ignore Blacklisted NPCs
                    if table.find(validEnemies, model) then return end

                    table.insert(validEnemies, model)
                    
                    -- PRE-CACHE METADATA (Performance Optimization)
                    -- This avoids calling GetDescendants and string operations every frame
                    local metadata = {
                        isMutant = isMutantEntity(model),
                        isBoss = isBossEntity(model),
                        isShield = isShieldEntity(model),
                        elite = isEliteEntity(model)
                    }
                    entityCache[model] = metadata
                    model.AncestryChanged:Connect(function()
                        if not model:IsDescendantOf(game) then
                            local index = table.find(validEnemies, model)
                            if index then table.remove(validEnemies, index) end
                            entityCache[model] = nil -- Clean up cache too
                        end
                    end)
                    -- Removing from validEnemies on Died is now handled in the main Aim loop
                    -- to allow for "Death State Bypassing" during dodge rolls.
                end

                -- Scan Logic
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then addEnemy(obj) end
                end
                workspace.DescendantAdded:Connect(function(descendant)
                    if descendant:IsA("Model") then
                        task.wait(0.1)
                        if descendant:FindFirstChildOfClass("Humanoid") then addEnemy(descendant) end
                    end
                end)

                -- Helper check replaced by robust version above

                local lastTarget = nil -- Store last valid target for locking
                local lastTargetTime = 0
                local lastLoggedTarget = nil -- Store last NPC printed in debug logs

                -- 2. Aim Logic
                local globalRayParams = RaycastParams.new()
                globalRayParams.FilterType = Enum.RaycastFilterType.Exclude
                globalRayParams.IgnoreWater = true

                -- 2. Aim Logic (Optimized)
            -- Helper function extracted to reduce register pressure in getClosestTarget
            local function checkPartVisibility(part, targetModel, myChar, rayParams)
                if not part then return false end
                local origin = Camera.CFrame.Position
                local tPos = part.Position
                local direction = (tPos - origin)
                
                local currentFilter = {myChar, Camera}
                for i = 1, 4 do 
                    rayParams.FilterDescendantsInstances = currentFilter
                    local result = workspace:Raycast(origin, direction, rayParams)
                    if not result then return true, tPos end
                    
                    local hit = result.Instance
                    local isPartOfChar = hit:IsDescendantOf(targetModel)
                    
                    local lowerName = string.lower(hit.Name)
                    if string.find(lowerName, "shield") or string.find(lowerName, "khiên") then 
                        -- Fix: If it's THEIR shield, we consider it "visible" enough to lock
                        if isPartOfChar then
                            return true, tPos
                        else
                            return false 
                        end
                    end
                    
                    if isPartOfChar or hit == part then return true, tPos end
                    
                    if hit.Transparency > 0.7 or not hit.CanCollide then
                        table.insert(currentFilter, hit)
                    else
                        return false
                    end
                end
                return false
            end

            -- 2. Aim Logic (Optimized)
            local function getClosestTarget()
                local mousePos = UserInputService:GetMouseLocation()
                local candidates = {}
                local char = LocalPlayer.Character
                local myRoot = char and char:FindFirstChild("HumanoidRootPart")
                if not myRoot then return end
                local myPos = myRoot.Position

                -- PASS 1: Lightweight Screening (2D Proximity & Status)
                for _, enemy in ipairs(validEnemies) do
                    if not enemy or enemy == char then continue end
                    local root = enemy:FindFirstChild("HumanoidRootPart")
                    local humanoid = nil
                    for _, c in ipairs(enemy:GetChildren()) do
                        if c:IsA("Humanoid") and c.Health > 0 then
                            humanoid = c
                            break
                        end
                    end
                    if not humanoid then humanoid = enemy:FindFirstChild("Humanoid") end
                    if not root or not humanoid then continue end

                    -- Metadata Cache
                    local meta = entityCache[enemy]
                    if not meta then
                        meta = {
                            isMutant = isMutantEntity(enemy),
                            isBoss = isBossEntity(enemy),
                            isShield = isShieldEntity(enemy),
                            isHighMob = isHighMobilityEntity(enemy)
                        }
                        entityCache[enemy] = meta
                    end

                    -- Distance & FOV Check
                    local dist3D = (myPos - root.Position).Magnitude
                    local maxRange = meta.isBoss and 2000 or 400
                    if dist3D > maxRange then continue end

                    local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                    
                    if not onScreen then continue end

                    local mouseDist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if mouseDist > aimFOV then continue end

                    -- Death/State Logic (Strict Filter)
                    local isDead = (humanoid.Health <= 0) or (humanoid:GetState() == Enum.HumanoidStateType.Dead)
                    
                    -- NEW: Downed/Ragdoll Check (Fixes Aiming at Ground)
                    local head = enemy:FindFirstChild("Head")
                    local headY = head and head.Position.Y or 0
                    local rootY = root.Position.Y
                    local heightDiff = math.abs(headY - rootY)
                    
                    -- PRONE MEMORY: Keep them marked as prone for 2.5s if they hit any threshold
                    local isCurrentlyProne = humanoid.PlatformStand or 
                                             (humanoid:GetState() == Enum.HumanoidStateType.FallingDown) or 
                                             (humanoid:GetState() == Enum.HumanoidStateType.Ragdoll) or
                                             (humanoid:GetState() == Enum.HumanoidStateType.Physics) or
                                             (humanoid.Sit) or (root.CFrame.UpVector.Y < 0.4) or
                                             (heightDiff < 0.8) or (enemy:FindFirstChild("Stun") or enemy:FindFirstChild("Stunned"))
                    
                    if isCurrentlyProne then meta.lastProneTime = tick() end
                    local isDowned = (tick() - (meta.lastProneTime or 0) < 0.5)
                    
                    if isDead or isDowned then
                        -- BOSS/SHIELD EXEMPTION: Always track bosses and shield-enemies even if downed
                        if not (meta.isBoss or meta.isShield) then
                            local velocityMag = root.Velocity.Magnitude
                            -- Strict Bypass for High-Speed Rolls (only if not completely ragdolled)
                            if not isDowned and velocityMag <= 25.0 then continue end
                            -- If they are downed/ragdolled and not moving extremely fast, skip
                            if isDowned and velocityMag <= 15.0 then continue end
                        end
                    end

                    if root.Anchored and not hasWeapon(enemy) and not meta.isBoss then continue end
                    
                    table.insert(candidates, {
                        model = enemy,
                        dist = mouseDist,
                        dist3D = dist3D,
                        root = root,
                        humanoid = humanoid,
                        meta = meta,
                        isDead = isDead
                    })
                end

                -- Sort by Hybrid Score (Mouse Distance + 3D Distance Weights)
                -- PRIORITY: Bosses get a significant bonus. Closer 3D threats are weighted at 1/5 pixels.
                table.sort(candidates, function(a, b) 
                    local scoreA = a.dist + (a.dist3D / 5) - (a.meta.isBoss and 300 or 0)
                    local scoreB = b.dist + (b.dist3D / 5) - (b.meta.isBoss and 300 or 0)
                    return scoreA < scoreB
                end)

                -- PASS 2: Heavy Physics (Visibility) on Top Candidates
                globalRayParams.FilterDescendantsInstances = {char, Camera}
                
                for _, cand in ipairs(candidates) do
                    local character = cand.model
                    local meta = cand.meta
                    
                    -- Check Targets using extracted helper
                    local currentTargetPart = nil
                    local currentLockedPos = nil
                    
                    local targets = {"Head", "UpperTorso", "HumanoidRootPart"}
                    for _, name in ipairs(targets) do
                        local p = character:FindFirstChild(name)
                        local vis, pos = checkPartVisibility(p, character, char, globalRayParams)
                        if vis then currentTargetPart, currentLockedPos = p, pos; break end
                    end
                    
                    if not currentTargetPart then
                        local detailParts = {"RightUpperArm", "LeftUpperArm", "RightLowerArm", "LeftLowerArm", "RightLowerLeg", "LeftLowerLeg"}
                        for _, name in ipairs(detailParts) do
                            local part = character:FindFirstChild(name)
                            local vis, pos = checkPartVisibility(part, character, char, globalRayParams)
                            if vis then currentTargetPart, currentLockedPos = part, pos; break end
                        end
                    end
                    
                    -- Valid Target Found? Return immediately (Snap to it!)
                    if currentTargetPart then
                        local isFacingAway = (cand.root.CFrame.LookVector:Dot(Camera.CFrame.LookVector) > 0.6)
                        
                        -- DYNAMIC SHIELD BYPASS: Disable offset if downed OR facing away
                        local hum = cand.humanoid
                        local root = cand.root
                        local head = character:FindFirstChild("Head")
                        local hDiff = head and math.abs(head.Position.Y - root.Position.Y) or 5
                        
                        local isCurrentlyProne = hum.PlatformStand or (hum:GetState() == Enum.HumanoidStateType.FallingDown) or (hum:GetState() == Enum.HumanoidStateType.Ragdoll) or (hum:GetState() == Enum.HumanoidStateType.Physics) or (hum.Sit) or (root.CFrame.UpVector.Y < 0.4) or (hDiff < 0.8) or (character:FindFirstChild("Stun") or character:FindFirstChild("Stunned"))
                        if isCurrentlyProne then meta.lastProneTime = tick() end
                        
                        local isProne = (tick() - (meta.lastProneTime or 0) < 0.5)
                        local shouldApplyOffset = meta.isShield and not (isProne or isFacingAway)

                        -- Persistence Update
                        lastTarget = character
                        lastTargetTime = tick()

                        -- Debug Update removed for production

                        return currentTargetPart, currentLockedPos, shouldApplyOffset, cand.root.Velocity, currentTargetPart.Name, meta.isHighMob, isFacingAway, character
                    end
                end

                -- PASS 3: Target Persistence (Grace Period for Bosses/Active Targets)
                -- If we lost the target due to teleport/jump, try to find it again for 0.5s
                if lastTarget and lastTarget.Parent and (tick() - lastTargetTime < 0.5) then
                    local character = lastTarget
                    local root = character:FindFirstChild("HumanoidRootPart")
                    local hum = character:FindFirstChildOfClass("Humanoid")
                    
                    if root and hum and hum.Health > 0 then
                        local meta = entityCache[character] or {isBoss = isBossEntity(character)}
                        
                        -- For bosses, we allow "loose" tracking (check more parts if needed)
                        local targets = {"Head", "UpperTorso", "HumanoidRootPart", "LowerTorso", "RightUpperArm", "LeftUpperArm"}
                        for _, name in ipairs(targets) do
                            local p = character:FindFirstChild(name)
                            if p then
                                local vis, pos = checkPartVisibility(p, character, char, globalRayParams)
                                if vis or meta.isBoss then -- Bosses can be tracked even if occluded for 0.5s
                                    -- DYNAMIC SHIELD BYPASS (Persistence): Disable offset if downed
                                    local headPos = character:FindFirstChild("Head") and character.Head.Position.Y or 0
                                    local hDiff = math.abs(headPos - root.Position.Y)
                                    local isCurrentlyProne = hum.PlatformStand or (hum:GetState() == Enum.HumanoidStateType.FallingDown) or (hum:GetState() == Enum.HumanoidStateType.Ragdoll) or (hum:GetState() == Enum.HumanoidStateType.Physics) or (hum.Sit) or (root.CFrame.UpVector.Y < 0.4) or (hDiff < 0.8) or (character:FindFirstChild("Stun") or character:FindFirstChild("Stunned"))
                                    if isCurrentlyProne then meta.lastProneTime = tick() end
                                    
                                    local isProne = (tick() - (meta.lastProneTime or 0) < 0.5)
                                    local shouldApplyOffset = meta.isShield and not isProne
                                    
                                    return p, pos or p.Position, shouldApplyOffset, root.Velocity, p.Name, meta.isHighMob, false, character
                                end
                            end
                        end
                    end
                end
                
                return nil
            end

                -- 3. Aim Loop
                local isAiming = false
                UserInputService.InputBegan:Connect(function(input, gpe)
                    if input.UserInputType == aimKey then isAiming = true end
                end)
                UserInputService.InputEnded:Connect(function(input, gpe)
                    if input.UserInputType == aimKey then 
                        isAiming = false 
                        lastTarget = nil -- Reset target when releasing mouse
                        lastLoggedTarget = nil -- Reset debug log state to allow re-logging same NPC
                    end
                end)

                local debugLabel = nil
                RunService.RenderStepped:Connect(function()
                    if not ScreenGui.Parent then return end
                    
                    -- Debug Label Management
                    if aimBotDebug then
                        if not debugLabel then
                            debugLabel = Instance.new("TextLabel")
                            debugLabel.Name = "AimDebugLabel"
                            debugLabel.Size = UDim2.new(0, 200, 0, 50)
                            debugLabel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                            debugLabel.BackgroundTransparency = 0.5
                            debugLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
                            debugLabel.Font = Enum.Font.Code
                            debugLabel.TextSize = 14
                            debugLabel.Visible = false
                            debugLabel.Parent = ScreenGui
                            
                            local uiCorner = Instance.new("UICorner")
                            uiCorner.Parent = debugLabel
                        end
                    else
                        if debugLabel then debugLabel:Destroy() debugLabel = nil end
                    end

                    if aimEnabled then
                        if isAiming then
                            local targetPart, targetPos, isShield, velocity, partName, isHighMob, isFacingAway, targetChar = getClosestTarget()
                            if targetPart and targetPos then
                                -- Update Debug Label
                                if debugLabel and targetChar then
                                    local mouseParams = UserInputService:GetMouseLocation()
                                    debugLabel.Position = UDim2.new(0, mouseParams.X + 20, 0, mouseParams.Y + 20)
                                    debugLabel.Text = string.format("TARGET: %s\nOFFSET: %s", targetChar.Name, isShield and "ON" or "OFF")
                                    debugLabel.Visible = true
                                end

                                local currentCF = Camera.CFrame
                                local finalTargetPos = targetPos
                                
                                -- 1. VELOCITY PREDICTION (Fixes tracking during dodge rolls)
                                -- Factor is based on aim smoothness and distance to simulate shell travel/tracking lag
                                local predictionFactor = isHighMob and 0.15 or 0.08
                                if velocity.Magnitude > 2 then
                                    finalTargetPos = finalTargetPos + (velocity * predictionFactor)
                                end
                                
                                -- 2. SHIELD OFFSET (Right + Up)
                                if isShield then
                                    finalTargetPos = finalTargetPos + (currentCF.RightVector * aimRightOffset) + (currentCF.UpVector * aimUpOffset)
                                end
                                
                                -- 3. ADAPTIVE SMOOTHING (Faster snapping for fast targets)
                                local adaptiveSmooth = aimSmoothness
                                local velocityMag = velocity.Magnitude
                                if velocityMag > 3 then
                                    -- Scaled multiplier based on velocity to catch even non-RSU fast rollers
                                    local speedMult = math.clamp(velocityMag / 8, 1.5, 3.5)
                                    adaptiveSmooth = math.clamp(aimSmoothness * speedMult, 0.05, 0.98)
                                end
                                
                                local targetCF = CFrame.new(currentCF.Position, finalTargetPos)
                                Camera.CFrame = currentCF:Lerp(targetCF, adaptiveSmooth)
                            else
                                if debugLabel then debugLabel.Visible = false end
                            end
                        else
                            if debugLabel then debugLabel.Visible = false end
                        end
                    else
                        if debugLabel then debugLabel.Visible = false end
                    end
                end)

                createToggle(CombatTab, "Aim Bot", false, function(state)
                    aimEnabled = state
                end)

                createToggle(CombatTab, "Aim Debug (F9)", false, function(state)
                    aimBotDebug = state
                end)

                -- ====================
                -- CATEGORY: VISUALS
                -- ====================

                -- 1. Player ESP
                -- 1. Player ESP (Optimized Highlight Manager)
                local espEnabled = false
                local espContainer = Instance.new("Folder")
                espContainer.Name = "ExaminationESP"
                espContainer.Parent = CoreGui

                local potentialPlayerTargets = {}

                local function clearESP() 
                    espContainer:ClearAllChildren() 
                    potentialPlayerTargets = {}
                end

                local staffCache = {}
                local staffCheckDebounce = {}

                local function isPlayerInfected(plr)
                    if not plr then return false end
                    
                    -- 1. TEAM CHECK
                    local team = plr.Team
                    if team then
                        local tn = string.lower(team.Name)
                        if string.find(tn, "infect") or string.find(tn, "monster") or string.find(tn, "zombie") or string.find(tn, "vật thí nghiệm") then
                            return true
                        end
                    end

                    -- 2. TOOL/MARKER CHECK
                    local char = plr.Character
                    if char then
                        if char:FindFirstChild("Infected") or char:FindFirstChild("Claw") or char:FindFirstChild("Bite") then return true end
                        -- Recursive tool check for "Claw" or "Bite"
                        for _, child in ipairs(char:GetChildren()) do
                            if child:IsA("Tool") then
                                local n = string.lower(child.Name)
                                if n == "claw" or n == "bite" or n == "infect" or n == "attack" then return true end
                            end
                        end
                    end

                    return false
                end
                
                local function managePlayerHighlights()
                    while espEnabled do
                        if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                            task.wait(1)
                            continue
                        end
                        
                        local myPos = LocalPlayer.Character.HumanoidRootPart.Position
                        
                        for player, _ in pairs(potentialPlayerTargets) do
                            if not player or not player.Parent then 
                                potentialPlayerTargets[player] = nil
                                staffCache[player] = nil
                                continue 
                            end
                            
                            local char = player.Character
                            if not char or not char:IsDescendantOf(game) then 
                                continue 
                            end
                            
                            local root = char:FindFirstChild("HumanoidRootPart")
                            if not root then continue end

                            -- STAFF CHECK
                            local isStaff = staffCache[player]
                            if isStaff == nil and not staffCheckDebounce[player] then
                                staffCheckDebounce[player] = true
                                task.spawn(function()
                                    local s, _ = detectStaff(player)
                                    staffCache[player] = s or false
                                    staffCheckDebounce[player] = nil
                                end)
                            end
                            
                            local dist = (root.Position - myPos).Magnitude
                            local hl = char:FindFirstChild("ESPHighlight")
                            
                            -- SLOT MANAGEMENT: Only highlight if < 150 studs (UNLESS STAFF)
                            if dist < 150 or isStaff then
                                if not hl then
                                    hl = Instance.new("Highlight")
                                    hl.Name = "ESPHighlight"
                                    hl.Adornee = char
                                    hl.FillTransparency = 1 -- Outline only
                                    hl.OutlineTransparency = 0
                                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                                    hl.Parent = char 
                                    
                                    -- Failsafe Cleanup
                                    char.AncestryChanged:Connect(function()
                                        if not char:IsDescendantOf(game) and hl then hl:Destroy() end
                                    end)
                                end

                                -- UPDATE COLOR
                                local isInfected = isPlayerInfected(player)
                                
                                if isStaff then
                                    hl.FillColor = Color3.fromRGB(255, 0, 255) -- Purple
                                    hl.OutlineColor = Color3.fromRGB(255, 0, 255)
                                elseif isInfected then
                                    hl.FillColor = Color3.fromRGB(0, 255, 255) -- Aqua (Cyan)
                                    hl.OutlineColor = Color3.fromRGB(0, 255, 255)
                                    hl.FillTransparency = 1 -- Keep outline only as requested
                                else
                                    hl.FillColor = Color3.fromRGB(0, 150, 255) -- Blue
                                    hl.OutlineColor = Color3.fromRGB(0, 150, 255)
                                end
                            else
                                -- Too far, free up the slot for Bosses/Nearby Enemies
                                if hl then hl:Destroy() end
                            end
                        end
                        task.wait(0.2)
                    end
                end

                local function addESP(player)
                    if player == LocalPlayer then return end
                    potentialPlayerTargets[player] = true
                end

                createToggle(VisualsTab, "Player ESP", false, function(state)
                    espEnabled = state
                    if state then
                        for _, plr in ipairs(Players:GetPlayers()) do
                            if plr ~= LocalPlayer then addESP(plr) end
                        end
                        Players.PlayerAdded:Connect(function(plr)
                            if espEnabled and plr ~= LocalPlayer then addESP(plr) end
                        end)
                        task.spawn(managePlayerHighlights)
                    else
                        clearESP()
                        -- Loop handles cleanup of individual highlights next cycle or manually here if needed
                        for _, plr in ipairs(Players:GetPlayers()) do
                            if plr.Character and plr.Character:FindFirstChild("ESPHighlight") then
                                plr.Character.ESPHighlight:Destroy()
                            end
                        end
                    end
                end)



                -- 2. Infect ESP (Enemies) - Optimized Distance Limit
                local infectEspEnabled = false
                local infectEspContainer = Instance.new("Folder")
                infectEspContainer.Name = "InfectESP"
                infectEspContainer.Parent = CoreGui

                -- Track Potential Enemies for ESP
                local potentialEspTargets = {} 

                local function clearInfectESP() 
                    infectEspContainer:ClearAllChildren() 
                    -- Manual Cleanup because Highlights are now parented to Models
                    for model, _ in pairs(potentialEspTargets) do
                        if model and model:FindFirstChild("InfectHighlight") then
                            model.InfectHighlight:Destroy()
                        end
                    end
                    potentialEspTargets = {}
                end

                local function manageInfectHighlights()
                    local printedBossDebug = {} -- Debounce for debug prints
                    
                    while infectEspEnabled do
                        if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                            task.wait(1)
                            continue
                        end
                        
                        local myPos = LocalPlayer.Character.HumanoidRootPart.Position
                        
                        for model, _ in pairs(potentialEspTargets) do
                        if not model.Parent or not model:IsDescendantOf(workspace) then 
                            potentialEspTargets[model] = nil 
                            local highlight = model:FindFirstChild("InfectHighlight")
                            if highlight then pcall(function() highlight:Destroy() end) end
                            continue 
                        end

                        -- STRICT FAILSAFE: Remove Self and Players (Players are handled by Player ESP)
                        local isPlr = Players:GetPlayerFromCharacter(model)
                        if model == LocalPlayer.Character or model.Name == LocalPlayer.Name or isPlr then
                            potentialEspTargets[model] = nil
                            local highlight = model:FindFirstChild("InfectHighlight")
                            if highlight then pcall(function() highlight:Destroy() end) end
                            continue
                        end
                            
                            local root = model:FindFirstChild("HumanoidRootPart")
                            -- Prioritize Living Humanoid (Fix for Resurrection/Duplicate Humanoids)
                            local humanoid = nil
                            local firstHum = nil
                            for _, child in ipairs(model:GetChildren()) do
                                if child:IsA("Humanoid") then
                                    if not firstHum then firstHum = child end
                                    if child.Health > 0 then
                                        humanoid = child
                                        break
                                    end
                                end
                            end
                            humanoid = humanoid or firstHum
                            
                            -- SKIP DEAD/INVALID 
                        local velocityMag = root and root.Velocity.Magnitude or 0
                        local isDead = (humanoid.Health <= 0) or (humanoid:GetState() == Enum.HumanoidStateType.Dead) or (humanoid.Parent == nil)
                        
                        -- NEW: Downed/Ragdoll Check (Keep ESP during pushes/knockdowns)
                        local modelName = string.lower(model.Name)
                        local isSleeping = false
                        for _, name in ipairs(sleepingEnemies) do
                            if string.find(modelName, name) then isSleeping = true break end
                        end

                        local isDowned = humanoid.PlatformStand or 
                                         (humanoid:GetState() == Enum.HumanoidStateType.FallingDown) or 
                                         (humanoid:GetState() == Enum.HumanoidStateType.Ragdoll) or
                                         (humanoid:GetState() == Enum.HumanoidStateType.Physics)

                        -- SKIP DEAD/INVALID 
                        -- If dead and not moving fast (rolling) and NOT downed (pushed), remove highlight
                        if isDead and not isDowned then
                            -- Only keep highlight if they are in a high-speed roll (death state bypass)
                            if velocityMag < 5 then -- Lowered from 20 to 5 to avoid losing highlight on slow push
                                local highlight = model:FindFirstChild("InfectHighlight")
                                if highlight then pcall(function() highlight:Destroy() end) end
                                -- If they stay dead/still, remove from tracking
                                if velocityMag < 1 then
                                    potentialEspTargets[model] = nil
                                end
                                continue
                            end
                        end

                            if root then
                                local dist = (root.Position - myPos).Magnitude
                                
                                -- Distance Sanity Check (Don't remove Boss/Whitelisted ESP even if close)
                                if not (isBoss or isSleeping) and dist < 2 then 
                                    potentialEspTargets[model] = nil 
                                    local highlight = model:FindFirstChild("InfectHighlight")
                                    if highlight then highlight:Destroy() end
                                    continue
                                end

                                -- BOSS CHECK (Priority)
                                local isBoss = isBossEntity(model)

                                local maxDist = isBoss and 2000 or 150 -- Bosses have near infinite range

                                local highlight = model:FindFirstChild("InfectHighlight")
                                
                                if dist < maxDist then
                                    local hl = highlight
                                    if not hl then
                                        -- Create Highlight
                                        hl = Instance.new("Highlight")
                                        hl.Name = "InfectHighlight"
                                        hl.Adornee = model
                                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                                        hl.FillTransparency = 0.85
                                        hl.OutlineTransparency = 0
                                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                                        hl.Parent = model
                                    end

                                    -- DYNAMIC STYLE UPDATE (Boss = Purple, Elite = Orange, Default = Red Outline)
                                    local isElite = isEliteEntity(model)
                                    
                                    if isBoss then
                                        hl.FillColor = Color3.fromRGB(130, 0, 255)
                                        hl.OutlineColor = Color3.fromRGB(200, 100, 255)
                                        hl.FillTransparency = 1 -- Outline only
                                    elseif isElite then
                                        hl.FillColor = Color3.fromRGB(255, 140, 0) -- Orange
                                        hl.OutlineColor = Color3.fromRGB(255, 200, 0) -- Brighter Orange Outline
                                        hl.FillTransparency = 1 -- Outline only
                                    else
                                        hl.FillColor = Color3.fromRGB(255, 0, 0)
                                        hl.OutlineColor = Color3.fromRGB(255, 0, 0)
                                        hl.FillTransparency = 1 -- Outline only
                                    end
                                else
                                    -- Too far, remove highlight to save rendering slots
                                    if highlight then highlight:Destroy() end
                                end
                            end
                        end
                        task.wait(0.1) -- Fast Update (10 times a second for instant kill feedback)
                    end
                end

                local function addInfectESP(model)
                    if not infectEspEnabled then return end
                if model == LocalPlayer.Character or model.Name == LocalPlayer.Name then return end
                if Players:GetPlayerFromCharacter(model) or Players:FindFirstChild(model.Name) then return end
                    
                    local humanoid = model:FindFirstChildOfClass("Humanoid")
                    if not humanoid then return end
                    
                    if Camera.CameraSubject == humanoid then return end

                    -- SMART FILTER (Event-Driven)
                    local root = model:FindFirstChild("HumanoidRootPart")
                    if not root then return end

                    local function isValidEnemy()
                        -- 0. Strict Self Check & Player Check
                        if model == LocalPlayer.Character or model.Name == LocalPlayer.Name then return false end
                        if Players:GetPlayerFromCharacter(model) or Players:FindFirstChild(model.Name) then return false end

                        -- 0.1 Name Blacklist (Prop filter)
                        if isNPCBlacklisted(model.Name) then return false end
                        
                        -- 0.2 Boss Check (Always visible)
                        local isBoss = isBossEntity(model)
                        if isBoss then return true end

                        -- 1. Sleeping Enemy Whitelist (Show even if Anchored)
                        local isSleeping = false
                        local modelName = string.lower(model.Name)
                        for _, name in ipairs(sleepingEnemies) do
                            if string.find(modelName, name) then
                                isSleeping = true
                                break
                            end
                        end

                        -- 2. Anchored check (Statue/Decoration filter)
                        -- If they are anchored and NOT a Boss and NOT a Sleeping enemy, ignore them.
                        if root.Anchored and not isSleeping then return false end
                        
                        return true
                    end

                    local function tryAdd()
                        if isValidEnemy() then
                            -- Check duplicates
                            if not potentialEspTargets[model] then
                                potentialEspTargets[model] = true
                                -- Cleanup listener if it became valid
                                -- (Note: In a full event system we'd disconnect specific listeners, but this is simple enough)
                            end
                        end
                    end

                    if isValidEnemy() then
                        tryAdd()
                    else
                        -- It's currently a "Statue" or "Spawning". Listen for state changes.
                        -- 1. Watch for Unanchoring (Movement allowed)
                        local anchorConn
                        anchorConn = root:GetPropertyChangedSignal("Anchored"):Connect(function()
                            if not root.Anchored then
                                tryAdd()
                                if anchorConn then anchorConn:Disconnect() anchorConn = nil end
                            end
                        end)
                        
                        -- 2. Watch for Weapon Equip
                        local toolConn
                        toolConn = model.ChildAdded:Connect(function(child)
                            task.wait() -- Wait for props
                            if hasWeapon(model) then
                                tryAdd()
                                if toolConn then toolConn:Disconnect() toolConn = nil end
                            end
                        end)
                        
                        -- Cleanup connections if model dies/removed before becoming valid
                        model.AncestryChanged:Connect(function()
                            if not model:IsDescendantOf(game) then
                                if anchorConn then anchorConn:Disconnect() end
                                if toolConn then toolConn:Disconnect() end
                            end
                        end)
                    end
                    
                    -- Standard Cleanup for valid targets is handled in the main loop or AncestryChanged above
                    model.AncestryChanged:Connect(function()
                        if not model:IsDescendantOf(game) then 
                            potentialEspTargets[model] = nil
                        end
                    end)
                end

                -- 3. Ammo ESP
                local ammoEspEnabled = false
                local ammoName = "Ammo"
                local potentialAmmoTargets = {}

                local function clearAmmoESP() 
                    for obj, _ in pairs(potentialAmmoTargets) do
                        if obj and obj:FindFirstChild("AmmoHighlight") then
                            obj.AmmoHighlight:Destroy()
                        end
                    end
                    potentialAmmoTargets = {}
                end

                local function addAmmoESP(obj)
                    if not ammoEspEnabled then return end
                    if not obj:IsA("BasePart") and not obj:IsA("Model") then return end
                    
                    -- Check Name Match (Case Insensitive)
                    if not string.find(string.lower(obj.Name), string.lower(ammoName)) then return end
                    
                    -- Check Interactivity (Filter out props)
                    local isInteractive = false
                    if obj:FindFirstChildWhichIsA("ClickDetector", true) or 
                    obj:FindFirstChildWhichIsA("ProximityPrompt", true) or
                    obj:FindFirstChildWhichIsA("TouchTransmitter", true) then
                        isInteractive = true
                    end
                    
                    if not isInteractive then return end
                    
                    -- Register as potential target
                    potentialAmmoTargets[obj] = true
                    
                    -- Cleanup on remove
                    obj.AncestryChanged:Connect(function()
                        if not obj:IsDescendantOf(game) then potentialAmmoTargets[obj] = nil end
                    end)
                end

                local function manageAmmoHighlights()
                    while ammoEspEnabled do
                        if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                            task.wait(1)
                            continue
                        end
                        
                        local myPos = LocalPlayer.Character.HumanoidRootPart.Position
                        
                        for obj, _ in pairs(potentialAmmoTargets) do
                            if not obj or not obj.Parent then 
                                potentialAmmoTargets[obj] = nil
                                continue 
                            end
                            
                            local pos = obj:IsA("Model") and (obj.PrimaryPart and obj.PrimaryPart.Position or obj:GetPivot().Position) or obj.Position
                            local dist = (pos - myPos).Magnitude
                            local hl = obj:FindFirstChild("AmmoHighlight")
                            
                            -- SLOT MANAGEMENT: Only highlight if < 150 studs
                            if dist < 150 then
                                if not hl then
                                    hl = Instance.new("Highlight")
                                    hl.Name = "AmmoHighlight"
                                    hl.Adornee = obj
                                    hl.FillColor = Color3.fromRGB(50, 255, 50) -- Lime Green
                                    hl.OutlineColor = Color3.fromRGB(0, 255, 0) -- Brighter Lime Outline
                                    hl.FillTransparency = 1 -- Outline only
                                    hl.OutlineTransparency = 0
                                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                                    hl.Parent = obj
                                end
                            else
                                -- Too far/Already has highlight, remove it
                                if hl then hl:Destroy() end
                            end
                        end
                        task.wait(0.5) -- Check twice a second
                    end
                end

                createToggle(VisualsTab, "Infected & Ammo ESP", false, function(state)
                    infectEspEnabled = state
                    ammoEspEnabled = state -- Sync ammo with infected
                    
                    if state then
                        -- Refresh existing
                        for _, obj in ipairs(workspace:GetDescendants()) do
                            if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
                                addInfectESP(obj)
                            elseif obj:IsA("BasePart") or obj:IsA("Model") then
                                addAmmoESP(obj)
                            end
                        end
                        -- Start Management Loops
                        task.spawn(manageInfectHighlights)
                        task.spawn(manageAmmoHighlights)
                    else
                        clearInfectESP()
                        clearAmmoESP()
                    end
                end)

                -- Unified Listener (Outside toggle to prevent connection leaks)
                workspace.DescendantAdded:Connect(function(obj)
                    if not (infectEspEnabled or ammoEspEnabled) then return end
                    -- Remove fixed wait, handling individual component additions is better
                    if not obj.Parent then return end
                    
                    -- 1. Catch MODEL Added (If complete)
                    if obj:IsA("Model") then
                        task.wait(0.1) -- Give it a moment for children
                        addInfectESP(obj)
                        if obj:IsA("BasePart") or obj:IsA("Model") then addAmmoESP(obj) end -- Fallback for Ammo Model
                    
                    -- 2. Catch HUMANOID Added (The reliable trigger)
                    elseif obj:IsA("Humanoid") then
                        addInfectESP(obj.Parent)
                    
                    -- 3. Catch ROOT PART Added (Another reliable trigger)
                    elseif obj.Name == "HumanoidRootPart" then
                        addInfectESP(obj.Parent)

                    -- 4. Ammo Check (Parts)
                    elseif obj:IsA("BasePart") then
                        addAmmoESP(obj)
                    end
                end)

                -- Ammo Event Listeners are now integrated into the Infected & Ammo ESP toggle

                -- 4. Aggressive Mouse Unlock (Shift Lock Fix)
                local mouseOverrideConnection = RunService.RenderStepped:Connect(function()
                    if not ScreenGui.Parent then 
                        if mouseOverrideConnection then mouseOverrideConnection:Disconnect() end
                        return 
                    end
                    
                    if MainFrame.Visible then
                        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
                        UserInputService.MouseIconEnabled = true
                        
                        -- Also ensure the modal fix is sized correctly just in case
                        local modal = MainFrame:FindFirstChild("ModalFix")
                        if modal then modal.Size = UDim2.new(1, 0, 1, 0) end
                    end
                end)

                -- Connections are managed at the top of the script now

                -- [ CLEANUP LOGIC ]
                local function cleanupGUI()
                    if mouseOverrideConnection then
                        mouseOverrideConnection:Disconnect()
                        mouseOverrideConnection = nil
                    end
                    
                    if fullBrightConnection then 
                        fullBrightConnection:Disconnect() 
                        fullBrightConnection = nil
                        Lighting.Brightness = 1
                        Lighting.GlobalShadows = true
                        Lighting.OutdoorAmbient = Color3.fromRGB(127, 127, 127)
                    end
                    
                    espEnabled = false
                    infectEspEnabled = false
                    aimEnabled = false
                    flyEnabled = false
                    
                    
                    if espContainer then espContainer:Destroy() end
                    if infectEspContainer then infectEspContainer:Destroy() end
                    
                    -- MANUAL ESP CLEANUP (Since we parent highlights to characters now)
                    for _, plr in ipairs(Players:GetPlayers()) do
                        if plr.Character and plr.Character:FindFirstChild("ESPHighlight") then
                            plr.Character.ESPHighlight:Destroy()
                        end
                    end
                    
                    clearInfectESP()
                    clearAmmoESP()
                    
                    for _, plr in ipairs(Players:GetPlayers()) do
                        if plr.Character then
                            if plr.Character:FindFirstChild("Head") and plr.Character.Head:FindFirstChild("ESPTest") then
                                plr.Character.Head.ESPTest:Destroy()
                            end
                            if plr.Character:FindFirstChild("ESPTestHighlight") then
                                plr.Character.ESPTestHighlight:Destroy()
                            end
                        end
                    end
                    
                    stopFly()
                    
                    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                        LocalPlayer.Character.Humanoid.WalkSpeed = 16
                        -- Reset collisions on GUI close
                        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                            if part:IsA("BasePart") then
                                -- WHITELIST: Only restore collision for CORE parts
                                local restoreList = {
                                    ["Head"] = true,
                                    ["HumanoidRootPart"] = true,
                                    ["Torso"] = true,
                                    ["UpperTorso"] = true,
                                    ["LowerTorso"] = true
                                }
                                if restoreList[part.Name] then
                                    part.CanCollide = true 
                                end
                            end
                        end
                    end
                    
                    if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end
                end

                CloseButton.MouseButton1Click:Connect(function()
                    ScreenGui:Destroy()
                    cleanupGUI()
                end)

                ScreenGui.AncestryChanged:Connect(function()
                    if not ScreenGui:IsDescendantOf(game) then
                        cleanupGUI()
                    end
                end)


                -- [ TOGGLE ALL KEYBIND ]
                UserInputService.InputBegan:Connect(function(input, gpe)
                    if input.KeyCode == Enum.KeyCode.RightControl and not gpe then
                        if MainFrame.Visible then
                            -- Minimize
                            MainFrame.Visible = false
                            OpenButton.Visible = true
                        else
                            -- Restore
                            MainFrame.Visible = true
                            OpenButton.Visible = false
                        end
                    end
                end)
