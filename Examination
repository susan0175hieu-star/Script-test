    local function checkTarget(character)
        if not character or character == LocalPlayer.Character then return end
        
        -- BLACKLIST (Friendlies)
        local n = string.lower(character.Name)
        if n == "npc" or string.find(n, "hizoimviewmodel") or string.find(n, "viewmodel") then return end

        if character:FindFirstChildOfClass("ForceField") then return end
        
        if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
        
        local humanoid = character:FindFirstChild("Humanoid")
        local head = character:FindFirstChild("Head")
        
        if not humanoid or not head or humanoid.Health <= 0 then return end
        
        -- STRICT STATE CHECK (Ignore Dead)
        local state = humanoid:GetState()
        if state == Enum.HumanoidStateType.Dead then return end

        -- STATUE/PROP CHECK (Sit/PlatformStand)
        -- Ignore unarmed entities that are sitting or platform standing (likely props/statues)
        if (humanoid.Sit or humanoid.PlatformStand) and not hasWeapon(character) then return end

        -- GLOBAL STATIONARY CHECK (Sleeping/Fake Corpse/FallingDown)
        -- If moving < 0.5 stud/s AND has no weapon => Ignore regardless of state
        local root = character:FindFirstChild("HumanoidRootPart")
        if root then
            local vel = root.Velocity.Magnitude
            local isArmed = hasWeapon(character)
            if vel < 0.5 and not isArmed then return end
        end

        -- NECK CHECK (Filter Dead Ragdolls)
        -- Stunned enemies (Physics state) usually keep joints, dead ones loose them.
        if state == Enum.HumanoidStateType.Physics then
            local neck = head:FindFirstChild("Neck") or 
                         (character:FindFirstChild("Torso") and character.Torso:FindFirstChild("Neck")) or
                         (character:FindFirstChild("UpperTorso") and character.UpperTorso:FindFirstChild("Neck"))
            
            -- ROOTJOINT CHECK (Double verification for ragdolls)
            local rootJoint = (character:FindFirstChild("LowerTorso") and character.LowerTorso:FindFirstChild("Root")) or
                              (character:FindFirstChild("HumanoidRootPart") and character.HumanoidRootPart:FindFirstChild("RootJoint"))
            
            if not neck or not rootJoint then return end -- Missing joints = Dead/Ragdoll
        end
        
        -- STRICT SELF CHECK
        if character == LocalPlayer.Character then return end
        
        -- VISIBILITY CHECK (Multi-Point)
        local origin = Camera.CFrame.Position
        local rayParams = RaycastParams.new()
        rayParams.FilterDescendantsInstances = {LocalPlayer.Character, character, Camera}
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.IgnoreWater = true
        
        local isVisible = false
        
        -- Helper to check a specific part
        -- Helper to check a specific part with Smart Penetration
        local function isPartVisible(part)
            local direction = (part.Position - origin)
            
            -- Recursively cast to penetrate transparent/non-collidable parts
            local sanity = 0
            while sanity < 10 do -- Limit penetration depth
                sanity = sanity + 1
                local result = workspace:Raycast(origin, direction, rayParams)
                if not result then return true end -- Reached destination
                
                -- Hit Obstacle. Check if penetrable.
                -- 1. High Transparency (Glass/Invisible Wall)
                -- 2. CanCollide = false (Phantom/Trigger)
                if result.Instance.Transparency > 0.5 or not result.Instance.CanCollide then
                    local filter = rayParams.FilterDescendantsInstances
                    table.insert(filter, result.Instance)
                    rayParams.FilterDescendantsInstances = filter
                    -- Continue loop
                else
                    return false -- Solid Wall
                end
            end
            return false -- Too many layers
        end
        
        -- SMART AIM: Scan Priority List for first visible part
        local targetPart = nil
        local priorityList = {
            "Head", "UpperTorso", "HumanoidRootPart", "Torso", "LowerTorso", -- Vitals
            "RightUpperArm", "LeftUpperArm", "Right Arm", "Left Arm",        -- Arms
            "RightUpperLeg", "LeftUpperLeg", "Right Leg", "Left Leg"         -- Legs
        }
        
        -- 1. Check Priority Parts
        for _, name in ipairs(priorityList) do
            local part = character:FindFirstChild(name)
            if part and isPartVisible(part) then
                targetPart = part
                break
            end
        end
        
        -- 2. Fallback: Any visible part
        if not targetPart then
             for _, part in ipairs(character:GetChildren()) do
                if part:IsA("BasePart") and part.Transparency < 1 and part ~= head and isPartVisible(part) then
                    targetPart = part
                    break
                end
             end
        end
        
        if not targetPart then return end -- No part visible
        
        -- DISTANCE CALCULATION
        local myPos = LocalPlayer.Character.HumanoidRootPart.Position
        local targetPos = targetPart.Position -- Use the visible part position
        local dist3D = (myPos - targetPos).Magnitude
        
        if dist3D < 5 then return end -- Too close/inside
        if dist3D > 300 then return end -- Max Range
        
        if dist3D < shortest3DDistance then
             closest = targetPart -- Aim at the specific visible part
             shortest3DDistance = dist3D
        end
    end

    for _, enemy in ipairs(validEnemies) do
        checkTarget(enemy)
    end
    return closest
end

