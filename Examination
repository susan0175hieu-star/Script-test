    workspace.DescendantAdded:Connect(function(obj)
        if not infectEspEnabled then return end
        -- Remove fixed wait, handling individual component additions is better
        if not obj.Parent then return end
        
        -- 1. Catch MODEL Added (If complete)
        if obj:IsA("Model") then
            task.wait(0.1) -- Give it a moment for children
            addInfectESP(obj)
        
        -- 2. Catch HUMANOID Added (The reliable trigger)
        elseif obj:IsA("Humanoid") then
            addInfectESP(obj.Parent)
        
        -- 3. Catch ROOT PART Added (Another reliable trigger)
        elseif obj.Name == "HumanoidRootPart" then
            addInfectESP(obj.Parent)
        end
    end)

