    local function IsVisible(target, part)
        if not wallCheckEnabled then return true end
        local origin = Camera.CFrame.Position
        local direction = part.Position - origin
        local params = RaycastParams.new()
        params.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.IgnoreWater = true
        local result = workspace:Raycast(origin, direction, params)
        if not result then return true end
        if result.Instance:IsDescendantOf(target) then return true end
        return false
    end

    -- [ OPTIMIZATION ] Execution State Cache (Reduces GetPlayingAnimationTracks calls)
    local executionState = {} 

    local function IsExecuting(humanoid, rootPart)
        if not ignoreExecution or not humanoid then return false end
        
        -- 1. Check Stun/Physics first (Cheap)
        if humanoid.PlatformStand or humanoid:GetState() == Enum.HumanoidStateType.Physics or humanoid:GetState() == Enum.HumanoidStateType.FallingDown then
            return true
        end

        local model = humanoid.Parent
        if not model then return false end

        -- 2. Check Cache
        local now = tick()
        local cache = executionState[humanoid]
        if cache and (now - cache.lastCheck < 0.15) then -- Check every 0.15s
            return cache.isExec
        end

        local isExec = false

        -- 3. Heavy Check (Only runs after cache expires)
        local canAttack = model:FindFirstChild("CanAttack")
        if canAttack and canAttack:IsA("BoolValue") and canAttack.Value == true then
            isExec = false
        else
            local animator = humanoid:FindFirstChild("Animator")
            if animator then
                for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                    if track.IsPlaying then
                        local weight = 1
                        local s, w = pcall(function() return track.WeightCurrent end)
                        if s and w then weight = w end
                        
                        if weight > 0.85 then
                            local animName = string.lower(track.Animation.Name)
                            for _, keyword in ipairs(IgnoredAnimKeywords) do
                                if string.find(animName, keyword) then isExec = true; break end
                            end
                            if isExec then break end

                            local idNum = string.match(track.Animation.AnimationId, "%d+")
                            for _, badId in ipairs(IgnoredAnimIDs) do
                                if idNum == badId then isExec = true; break end
                            end
                            if isExec then break end
                        end
                    end
                end
            end
        end

        -- Update Cache
        executionState[humanoid] = {lastCheck = now, isExec = isExec}
        return isExec
    end

