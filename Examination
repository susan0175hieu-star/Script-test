                if targetPart and targetPos then

                    local currentCF = Camera.CFrame
                    local finalTargetPos = targetPos
                    
                                    -- 1. VELOCITY SMOOTHING & PREDICTION
                                    -- Dampen the velocity to avoid jitter from NPC movement spikes
                                    smoothedVelocity = smoothedVelocity:Lerp(velocity, 0.2)
                                    
                                    local predictionFactor = isHighMob and 0.12 or 0.06
                                    if smoothedVelocity.Magnitude > 1.5 then
                                        finalTargetPos = finalTargetPos + (smoothedVelocity * predictionFactor)
                                    end
                                    
                                    -- 2. SHIELD OFFSET (Right + Up)
                                    if isShield then
                                        finalTargetPos = finalTargetPos + (currentCF.RightVector * aimRightOffset) + (currentCF.UpVector * aimUpOffset)
                                    end

                                    -- 3. BACK AIM LOGIC (New)
                                    if isFacingAway then
                                        -- Aim slightly "towards" the player to ensure back hit registration
                                        finalTargetPos = finalTargetPos - (currentCF.LookVector * 0.4)
                                    end
                                    
                                    -- 4. ADAPTIVE SMOOTHING (Fine-tuned for stability)
                                    local velocityMag = smoothedVelocity.Magnitude
                                    local adaptiveSmooth = aimSmoothness
                                    
                                    if velocityMag > 5 then
                                        -- Gradually increase speed but stay within stable limits
                                        local speedMult = math.clamp(velocityMag / 10, 1.2, 2.0)
                                        adaptiveSmooth = math.clamp(aimSmoothness * speedMult, 0.05, 0.6)
                                    end
                                    
                                    local targetCF = CFrame.new(currentCF.Position, finalTargetPos)
                                    Camera.CFrame = currentCF:Lerp(targetCF, adaptiveSmooth)
                end
            end
        end
    end)

