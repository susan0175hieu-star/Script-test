    -- [ CLEANUP LOGIC ]
    local function cleanupGUI()
        if mouseOverrideConnection then
            mouseOverrideConnection:Disconnect()
            mouseOverrideConnection = nil
        end
        
        if mainInputConn then
            mainInputConn:Disconnect()
            mainInputConn = nil
        end
        
        if fullBrightConnection then 
            fullBrightConnection:Disconnect() 
            fullBrightConnection = nil
            Lighting.Brightness = 1
            Lighting.GlobalShadows = true
            Lighting.OutdoorAmbient = Color3.fromRGB(127, 127, 127)
        end
        
        espEnabled = false
        infectEspEnabled = false
        aimEnabled = false
        flyEnabled = false
        
        
        if espContainer then espContainer:Destroy() end
        if infectEspContainer then infectEspContainer:Destroy() end
        
        -- MANUAL ESP CLEANUP (Since we parent highlights to characters now)
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Character and plr.Character:FindFirstChild("ESPHighlight") then
                plr.Character.ESPHighlight:Destroy()
            end
        end
        
        clearInfectESP()
        
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Character then
                if plr.Character:FindFirstChild("Head") and plr.Character.Head:FindFirstChild("ESPTest") then
                    plr.Character.Head.ESPTest:Destroy()
                end
                if plr.Character:FindFirstChild("ESPTestHighlight") then
                    plr.Character.ESPTestHighlight:Destroy()
                end
            end
        end
        
        stopFly()
        
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            LocalPlayer.Character.Humanoid.WalkSpeed = 16
            -- Reset collisions on GUI close
            for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    -- WHITELIST: Only restore collision for CORE parts
                    local restoreList = {
                        ["Head"] = true,
                        ["HumanoidRootPart"] = true,
                        ["Torso"] = true,
                        ["UpperTorso"] = true,
                        ["LowerTorso"] = true
                    }
                    if restoreList[part.Name] then
                        part.CanCollide = true 
                    end
                end
            end
        end
        
        if noclipConnection then noclipConnection:Disconnect() noclipConnection = nil end
    end

