local ammoEspEnabled = false
local ammoName = "Ammo"
local ammoEspContainer = Instance.new("Folder")
ammoEspContainer.Name = "AmmoESP"
ammoEspContainer.Parent = CoreGui

local function clearAmmoESP() ammoEspContainer:ClearAllChildren() end

local function addAmmoESP(obj)
    if not ammoEspEnabled then return end
    if not obj:IsA("BasePart") and not obj:IsA("Model") then return end
    
    -- Check Name Match (Case Insensitive)
    if not string.find(string.lower(obj.Name), string.lower(ammoName)) then return end
    
    -- Check Interactivity (Filter out props)
    local isInteractive = false
    if obj:FindFirstChildWhichIsA("ClickDetector", true) or 
       obj:FindFirstChildWhichIsA("ProximityPrompt", true) or
       obj:FindFirstChildWhichIsA("TouchTransmitter", true) then
        isInteractive = true
    end
    
    if not isInteractive then return end
    
    -- Check if already highlighted
    if obj:FindFirstChild("AmmoHighlight") then return end
    
    local hl = Instance.new("Highlight")
    hl.Name = "AmmoHighlight"
    hl.Adornee = obj
    hl.FillColor = Color3.fromRGB(255, 215, 0) -- Gold
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.FillTransparency = 0.5
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = ammoEspContainer
    
    -- Link destruction
    obj.AncestryChanged:Connect(function()
        if not obj:IsDescendantOf(game) then hl:Destroy() end
    end)
end

local function updateAmmoESP()
    clearAmmoESP()
    if not ammoEspEnabled then return end
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        addAmmoESP(obj)
    end
end

