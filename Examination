-- Tab Logic
local currentTab = nil
local tabs = {} -- Store references

local function switchTab(name)
    if currentTab then
        currentTab.Button.TextColor3 = THEME.Description
        currentTab.Button.BackgroundColor3 = Color3.fromRGB(25, 25, 30) -- Reset bg
        currentTab.Frame.Visible = false
    end
    
    local newTab = tabs[name]
    if newTab then
        newTab.Button.TextColor3 = THEME.Accent
        newTab.Button.BackgroundColor3 = Color3.fromRGB(35, 35, 40) -- Active bg
        newTab.Frame.Visible = true
        currentTab = newTab
    end
end

