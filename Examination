                RunService:UnbindFromRenderStep("ThirdPersonUpdate")
                return 
            end

            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            
            if hrp and hum then
                -- 1. DIRECT CAMERA LOCK (SIMPLIFIED & ROBUST)
            -- Get current rotation from Camera
            local camRot = Camera.CFrame.Rotation
            
            -- Calculate intended position relative to RAW HRP (No smoothing lag)
            -- DYNAMIC AIM OFFSET (Right Click logic)
            local isAimingRightClick = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
            
            -- Target Values
            local targetOffsetX = tpOffsetX 
            local targetOffsetY = isAimingRightClick and (tpOffsetY - 0.2) or tpOffsetY
            local targetDist    = isAimingRightClick and 2.5 or 4
            
            -- Smooth Transition (Lerp) - stored in valid scope
            getgenv().currentTP_X = math.lerp(getgenv().currentTP_X or tpOffsetX, targetOffsetX, 0.15)
            getgenv().currentTP_Y = math.lerp(getgenv().currentTP_Y or tpOffsetY, targetOffsetY, 0.15)
            getgenv().currentTP_Dist = math.lerp(getgenv().currentTP_Dist or 4, targetDist, 0.15)
            
            -- Apply FOV (Fixed at 70)
            Camera.FieldOfView = 70
            
            local offsetVector = Vector3.new(getgenv().currentTP_X, getgenv().currentTP_Y, 0)
            local desiredPos = hrp.Position + (camRot * offsetVector)
            
            -- Apply Backwards Zoom (Distance)
            desiredPos = desiredPos - (camRot.LookVector * getgenv().currentTP_Dist) 
            
            -- Set Camera CFrame Instantly
            Camera.CFrame = CFrame.new(desiredPos) * camRot

            -- 2. PROPERTIES LOCK
            LocalPlayer.CameraMode = Enum.CameraMode.Classic
            LocalPlayer.DevCameraOcclusionMode = Enum.DevCameraOcclusionMode.Invisicam
            
            if not freeMouseEnabled and UserInputService.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
                UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
            end

            -- 3. CHARACTER ROTATION (Smooth Physics)
            local ao = ensureAlignOrientation(char)
            if ao then
                ao.RigidityEnabled = false -- DISABLE RIGIDITY (Fixes Standing Jitter)
                ao.Responsiveness = 400     -- VERY STRONG ROTATION (Fixes Tap Firing Turn)
                hum.AutoRotate = false
                
                local lookV = Camera.CFrame.LookVector
                local flatLook = Vector3.new(lookV.X, 0, lookV.Z).Unit
                
                if flatLook.Magnitude > 0.1 then
                    ao.CFrame = CFrame.lookAt(Vector3.zero, flatLook)
                end
            end

            -- 4. AIMBOT SYNC (Simplified LookAt Logic)
            if aimEnabled and isAiming and getClosestTarget then
                local targetPart, targetPos, isShield = getClosestTarget() -- Added isShield
                if targetPos then
                    local currentCF = Camera.CFrame
                    local finalTargetPos = targetPos
                    
                    -- [ MANUAL AIM OFFSET ] (Tinh chỉnh độ lệch tâm tại đây)
                    local aimOffsetX = 1.5  -- Giảm nhẹ để tránh lệch quá đà
                    local aimOffsetY = 1.0  -- Giữ nguyên độ cao
                    
                    -- [ SHIELD BYPASS LOGIC ]
                    if isShield then
                        -- Kéo vào trong và đưa lên cao để trúng đầu
                        aimOffsetX = aimOffsetX + 0.78
                        aimOffsetY = aimOffsetY + 0.6
                    end
                    
                    -- FIX: Use World Up (Vector3.new(0,1,0)) for Height Offset to prevent recoil loop
                    -- Using currentCF.UpVector causes "Sky gazing" when camera pitches up
                    finalTargetPos = finalTargetPos + (currentCF.RightVector * aimOffsetX) + (Vector3.new(0, 1, 0) * aimOffsetY)
                    
                    -- Basic Logic: Look at Target directly
                    local aimRotation = CFrame.lookAt(currentCF.Position, finalTargetPos)
                    
                    -- Apply Smoothness
                    Camera.CFrame = currentCF:Lerp(aimRotation, 0.25)
                end
            end
            end
        end)
        else
        -- [[ DISABLED ]]
        RunService:UnbindFromRenderStep("ThirdPersonUpdate")
        
        -- Cleanup Physics Objects
        if LocalPlayer.Character then
            local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hrp then
