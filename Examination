    -- 1. Player ESP (Optimized Highlight Manager)
    local espEnabled = false
    local espContainer = Instance.new("Folder")
    espContainer.Name = "ExaminationESP"
    espContainer.Parent = CoreGui

    local potentialPlayerTargets = {}

    local function clearESP() 
        espContainer:ClearAllChildren() 
        potentialPlayerTargets = {}
    end

    local staffCache = {}
    local staffCheckDebounce = {}


    local function managePlayerHighlights()
        while espEnabled do
            if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                task.wait(1)
                continue
            end
            
            local myPos = LocalPlayer.Character.HumanoidRootPart.Position
            
            for player, _ in pairs(potentialPlayerTargets) do
                if not player or not player.Parent then 
                    potentialPlayerTargets[player] = nil
                    staffCache[player] = nil
                    continue 
                end
                
                local char = player.Character
                if not char or not char:IsDescendantOf(game) then 
                    continue 
                end
                
                local root = char:FindFirstChild("HumanoidRootPart")
                if not root then continue end

                -- STAFF CHECK
                local isStaff = staffCache[player]
                if isStaff == nil and not staffCheckDebounce[player] then
                    staffCheckDebounce[player] = true
                    task.spawn(function()
                        local s, _ = detectStaff(player)
                        staffCache[player] = s or false
                        staffCheckDebounce[player] = nil
                    end)
                end
                
                local dist = (root.Position - myPos).Magnitude
                local hl = char:FindFirstChild("ESPHighlight")
                
                -- SLOT MANAGEMENT: Only highlight if < 150 studs (UNLESS STAFF)
                if dist < 150 or isStaff then
                    if not hl then
                        hl = Instance.new("Highlight")
                        hl.Name = "ESPHighlight"
                        hl.Adornee = char
                        hl.FillTransparency = 1 -- Outline only
                        hl.OutlineTransparency = 0
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Parent = char 
                        
                        -- Failsafe Cleanup
                        char.AncestryChanged:Connect(function()
                            if not char:IsDescendantOf(game) and hl then hl:Destroy() end
                        end)
                    end

                    -- UPDATE COLOR
                    local isInfected = isPlayerInfected(player)
                    
                    local teamName = player.Team and string.lower(player.Team.Name) or ""
                    
                    if isStaff then
                        hl.FillColor = Color3.fromRGB(255, 0, 255) -- Purple
                        hl.OutlineColor = Color3.fromRGB(255, 0, 255)
                    elseif isInfected then
                        hl.FillColor = Color3.fromRGB(255, 170, 0) -- Orange (User Request)
                        hl.OutlineColor = Color3.fromRGB(255, 170, 0)
                        hl.FillTransparency = 1 
                    elseif string.find(teamName, "menlo") then -- Menlo Team (Humans)
                        hl.FillColor = Color3.fromRGB(0, 150, 255) -- Blue
                        hl.OutlineColor = Color3.fromRGB(0, 150, 255)
                    else
                        -- Optional: Other teams (Spectator/Lobby) can have a different color or be hidden
                        hl.FillColor = Color3.fromRGB(150, 150, 150) -- Gray for others
                        hl.OutlineColor = Color3.fromRGB(150, 150, 150)
                    end
                else
                    -- Too far, free up the slot for Bosses/Nearby Enemies
                    if hl then hl:Destroy() end
                end
            end
            task.wait(0.2)
        end
    end

    local function addESP(player)
        if player == LocalPlayer then return end
        potentialPlayerTargets[player] = true
    end

    createToggle(VisualsTab, "Player ESP", false, function(state)
        espEnabled = state
        if state then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer then addESP(plr) end
            end
            Players.PlayerAdded:Connect(function(plr)
                if espEnabled and plr ~= LocalPlayer then addESP(plr) end
            end)
