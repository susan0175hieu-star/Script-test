    -- [ ANTI-STAFF LOGIC ]
    local function detectStaff(player)
        if not player or player == LocalPlayer then return false end
        
        -- 1. Game Creator
        if player.UserId == game.CreatorId then
            return true, "Game Creator"
        end
        
        -- 2. Name Keywords (Frontier Pattern - Whole Word Only)
        local keywords = {"mod", "moderator", "admin", "administrator", "staff", "owner", "dev", "developer", "helper"}
        -- Add space to ensure boundaries between Name and DisplayName
        local nameStr = string.lower(player.Name .. " " .. player.DisplayName)
        
        for _, kw in ipairs(keywords) do
            -- %f[%a] matches start of word, %f[%A] matches end of word (boundary with non-letter)
            if string.find(nameStr, "%f[%a]" .. kw .. "%f[%A]") then
                return true, "Keyword Match: " .. kw
            end
        end
        
        -- 3. Group Rank (Existing)
        if Settings.AntiStaffGroupId > 0 then
            local s, rank = pcall(function() return player:GetRankInGroup(Settings.AntiStaffGroupId) end)
            if s and rank >= 200 then
                return true, "Group Staff (Rank " .. rank .. ")"
            end
        end

        -- 4. Backpack Scanner (Tool Check)
        -- Detects admin tools like BTools, F3X, Ban Hammer
        local backpack = player:FindFirstChild("Backpack")
        if backpack then
            for _, tool in ipairs(backpack:GetChildren()) do
                if tool:IsA("Tool") then
                    local n = string.lower(tool.Name)
                    if string.find(n, "btools") or string.find(n, "f3x") or string.find(n, "ban") or string.find(n, "admin") or string.find(n, "panel") or string.find(n, "god") then
                        return true, "Suspicious Tool: " .. tool.Name
                    end
                end
            end
        end
        
        -- 5. Attribute Scanner (God Mode Check)
        -- Detects infinite health or abnormal speed
        local char = player.Character
        if char then
            local hum = char:FindFirstChild("Humanoid")
            if hum then
                if hum.MaxHealth > 1000 and hum.Health > 1000 then
                    return true, "Abnormal Health: " .. math.floor(hum.MaxHealth)
                end
                if hum.WalkSpeed > 55 then
                    return true, "Abnormal Speed: " .. math.floor(hum.WalkSpeed)
                end
            end
        end
        
        return false
    end

