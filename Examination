        -- NEW: Downed/Ragdoll Check (Standard for other enemies)
        local head = enemy:FindFirstChild("Head")
        local headY = head and head.Position.Y or 0
        local rootY = root.Position.Y
        local heightDiff = math.abs(headY - rootY)

        -- Check Resurrecting State
        local isResurrecting = enemy:FindFirstChild("IsBusyResurrecting") and enemy.IsBusyResurrecting.Value
        
        -- PRONE MEMORY
        local isCurrentlyProne = humanoid.PlatformStand or 
                                (humanoid:GetState() == Enum.HumanoidStateType.FallingDown) or 
                                (humanoid:GetState() == Enum.HumanoidStateType.Ragdoll) or
                                (humanoid:GetState() == Enum.HumanoidStateType.Physics) or
                                (humanoid.Sit) or (root.CFrame.UpVector.Y < 0.4) or
                                (heightDiff < 0.8) or 
                                (enemy:FindFirstChild("Stun") or enemy:FindFirstChild("Stunned")) or
                                isResurrecting
                                -- REMOVED: (isStunBlacklist velocity check) - Caused FireRiser to be ignored when shooting

        if isCurrentlyProne then meta.lastProneTime = tick() end
        local isDowned = (tick() - (meta.lastProneTime or 0) < 0.2) 

        if isDead and not (meta and meta.ignoreHealth) then continue end 

        if isDowned then
            -- [SMART RELEASE] ALL ENEMIES
            -- If ANY enemy is confirmed stunned/downed provided they are NOT False Positives (FireRiser shooting)
            -- We want to release aim to switch to a damageable target.
            
            local isFalsePositive = string.find(nameLower, "fireriser") or string.find(nameLower, "riserhazmat") or string.find(nameLower, "slasher")
            
            if not isFalsePositive then
                -- OPTIMIZED: Direct check instead of loop
                local hasStunTag = enemy:FindFirstChild("Stun") or enemy:FindFirstChild("Stunned") or enemy:FindFirstChild("Knocked")
                local isStationary = (root.Velocity.Magnitude < 2.0)
                
                -- If it's a common enemy, we release completely
                if hasStunTag or isStationary then
                    continue -- Truly Stunned/Downed/Invincible -> RELEASE AIM
                end
            end
            
            -- Note: We REMOVED the Boss/Elite exemption. 
            -- Now, even Bosses will be skipped/deprioritized if they are in that "Invincible/Stunned" state.
        end

        -- ANCHORED CHECK (With Self-Defense Override)
        local isSelfDefense = (dist3D <= 40)
        local name = string.lower(enemy.Name)
        local isSlasher = string.find(name, "slasher")
        local isExempt = meta.isBoss or meta.isShield or meta.elite or meta.isMutant or isSlasher or hasWeapon(enemy)

        if root.Anchored and not (isSelfDefense or isExempt) then continue end

        table.insert(candidates, {
            model = enemy,
            dist = mouseDist,
            dist3D = dist3D,
            root = root,
            humanoid = humanoid,
            meta = meta,
            isDead = isDead,
            isDowned = isDowned -- Track if target is currently stunned/downed
        })
    end

    -- Sort by PROXIMITY (User Request: "Prioritize all monsters near self first")
    table.sort(candidates, function(a, b) 
        -- TIER 1: DANGER ZONE (< 50 studs) - Absolute Priority
        local aIsDanger = (a.dist3D < 50) and not a.isDowned
        local bIsDanger = (b.dist3D < 50) and not b.isDowned

        if aIsDanger and not bIsDanger then return true end
        if bIsDanger and not aIsDanger then return false end

        if aIsDanger and bIsDanger then
            return a.dist3D < b.dist3D -- Both standing in danger zone, closest wins
        end

        -- TIER 2: STANDARD SCORING (Distance & Mouse Proximity)
        -- EQUAL PRIORITY: No bonus for Bosses anymore. Purely based on Distance + FOV.
        local scoreA = (a.dist3D * 20) + a.dist 
        local scoreB = (b.dist3D * 20) + b.dist

        -- STUN/DOWNED PENALTY: Move downed targets to lowest priority
        -- APPLIES TO EVERYONE NOW (Bosses included) so we don't shoot invincible targets
        if a.isDowned then scoreA = scoreA + 2000 end
        if b.isDowned then scoreB = scoreB + 2000 end

        -- STICKINESS: Maintain target focus (Only for NOT downed targets)
        if a.model == lastTarget and not a.isDowned then scoreA = scoreA - 150 end
        if b.model == lastTarget and not b.isDowned then scoreB = scoreB - 150 end

        -- BACKSTAB PRIORITY: Bonus for targets facing away (vulnerable)
        local aIsBack = (a.root.CFrame.LookVector:Dot(Camera.CFrame.LookVector) > 0.5)
        local bIsBack = (b.root.CFrame.LookVector:Dot(Camera.CFrame.LookVector) > 0.5)
        if aIsBack then scoreA = scoreA - 80 end
        if bIsBack then scoreB = scoreB - 80 end

        return scoreA < scoreB
    end)

