        ao.RigidityEnabled = false -- DISABLE RIGIDITY TO FIX JITTER
        ao.MaxTorque = math.huge
        ao.MaxAngularVelocity = math.huge
        ao.Responsiveness = 40 -- LOWERED TO 40: Removes jitter by smoothing rotation
        return ao
    end

    if state then
        -- [[ ENABLED ]]
        
