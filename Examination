-- 1. Enemy Tracker (Smart Scanner)
local function addEnemy(model)
    if model == LocalPlayer.Character then return end
    local plr = Players:GetPlayerFromCharacter(model)
    if not model:FindFirstChildOfClass("Humanoid") then return end
    if isNPCBlacklisted(model.Name) then return end
    if table.find(validEnemies, model) then return end

    -- STATUE/MAP FILTER
    local root = model:FindFirstChild("HumanoidRootPart")
    local isSleeping = false
    local lowName = string.lower(model.Name)
    for _, sName in ipairs({"mikhail", "gilbert", "chimera", "lurker", "riser", "slasher", "rif"}) do
        if string.find(lowName, sName) then isSleeping = true; break end
    end

    local parentName = model.Parent and string.lower(model.Parent.Name) or ""
    local isMapObject = string.find(parentName, "decor") or string.find(parentName, "map") or string.find(parentName, "statue") or string.find(parentName, "prop")

    if root and (root.Anchored or isMapObject) and not isSleeping then return end

    -- PRE-CACHE METADATA (Strict Player/NPC Separation)
    local metadata = nil

    if plr then
        return -- [ ACTIVE PLAYER PROTECTION ] Only protect real, currently active player characters
    end

    -- [ AIM AT EVERYTHING ELSE ]
    -- If it's an NPC/Monster (even if it was a player), we aim.
    local targetData = getTargetData(model.Name)
    if targetData then
        metadata = {
            isMutant = targetData.isMutant or false,
            isBoss = targetData.isBoss or false,
            isShield = isShieldEntity(model),
            elite = targetData.elite or false,
            ignoreHealth = targetData.ignoreHealth or false
        }
    else
        -- Check if it looks like an infected/viral model even if not in list
        if string.find(lowName, "viral") or string.find(lowName, "infect") or string.find(lowName, "mutant") then
            metadata = { isMutant = true, isBoss = false, isShield = false, elite = false }
        else
            return -- Skip unknown props/objects
        end
    end

    table.insert(validEnemies, model)
    entityCache[model] = metadata
    model.AncestryChanged:Connect(function()
        if not model:IsDescendantOf(game) then
            local index = table.find(validEnemies, model)
            if index then table.remove(validEnemies, index) end
            entityCache[model] = nil -- Clean up cache too
            targetCache[model] = nil -- Clean up target cache too
        end
    end)
    -- Removing from validEnemies on Died is now handled in the main Aim loop
    -- to allow for "Death State Bypassing" during dodge rolls.
end

