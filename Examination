-- 2. Aim Logic
local function getClosestTarget()
    local closest = nil
    local shortest3DDistance = math.huge
    local mousePos = UserInputService:GetMouseLocation()
    
    local function checkTarget(character)
        if not character or character == LocalPlayer.Character then return end
        if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
        
        local humanoid = character:FindFirstChild("Humanoid")
        local head = character:FindFirstChild("Head")
        
        if not humanoid or not head or humanoid.Health <= 0 then return end
        
        -- STRICT STATE CHECK (Ignore Ragdolls/Dead)
        local state = humanoid:GetState()
        if state == Enum.HumanoidStateType.Dead or state == Enum.HumanoidStateType.Physics then return end
        
        -- STRICT SELF CHECK
        if character == LocalPlayer.Character then return end
        
        -- VISIBILITY CHECK (Multi-Point)
        local origin = Camera.CFrame.Position
        local rayParams = RaycastParams.new()
        rayParams.FilterDescendantsInstances = {LocalPlayer.Character, character, Camera}
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.IgnoreWater = true
        
        local isVisible = false
        
        -- Helper to check a specific part
        local function isPartVisible(part)
            local direction = (part.Position - origin)
            local result = workspace:Raycast(origin, direction, rayParams)
            if not result then return true end -- Clear line of sight
            return false
        end
        
        -- 1. Check Head first (Fastest match)
        if isPartVisible(head) then
            isVisible = true
        else
            -- 2. Check other body parts (Torso, Limbs)
            for _, part in ipairs(character:GetChildren()) do
                if part:IsA("BasePart") and part ~= head and part.Transparency < 1 then
                    if isPartVisible(part) then
                        isVisible = true
                        break
                    end
                end
            end
        end
        
        if not isVisible then return end -- No part visible
        
        -- DISTANCE CALCULATION
        local myPos = LocalPlayer.Character.HumanoidRootPart.Position
        local targetPos = head.Position
        local dist3D = (myPos - targetPos).Magnitude
        
        if dist3D < 5 then return end -- Too close/inside
        if dist3D > 300 then return end -- Max Range
        
        if dist3D < shortest3DDistance then
             closest = head
             shortest3DDistance = dist3D
        end
    end

    for _, enemy in ipairs(validEnemies) do
        checkTarget(enemy)
    end
    return closest
end

