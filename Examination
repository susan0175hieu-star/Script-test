            end
        end

        local humanoid = entry.hum
        local root = entry.root
        local meta = entry.meta

        -- Distance & FOV Check
        local dist3D = (myPos - root.Position).Magnitude
        local maxRange = meta.isBoss and 2000 or 400
        if dist3D > maxRange then continue end

        local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
        local isAmbush = (dist3D < 50) -- 360 DEGREEE LOGIC: Detect threats behind/close automatically (Increased from 35)

        -- Filter: Only allow if on screen OR extremely close (360 defense)
        if not (onScreen or isAmbush) then continue end

        local mouseDist = onScreen and (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude or (aimFOV * 2)
        -- FOV Filter: Only applies to enemies outside the Ambush/Danger zone
        if not isAmbush and mouseDist > aimFOV then continue end

        -- Death/State Logic (Strict Filter)
        local isDead = (humanoid.Health <= 0) or (humanoid:GetState() == Enum.HumanoidStateType.Dead)

        -- [ABSOLUTE STUN BLACKLIST] - IMPROVED BYPASS
        local nameLower = string.lower(enemy.Name)
        
        -- GROUP 1: High-Threat Variants (MUST AIM)
        -- FireRiser, RiserHazmat, Armored Riser, etc. contain "Riser" but act differently.
        -- We explicitly whitelist them to SKIP the stun check below.
        local isHighThreatRiser = string.find(nameLower, "fireriser") or 
                                  string.find(nameLower, "riserhazmat") or 
                                  string.find(nameLower, "armored")
                                  
        -- GROUP 2: Common Fodder Risers (fodder)
        -- Only apply the strict "Release if Stationary" logic to these specific guys.
        local isCommonRiser = string.find(nameLower, "riser") and not isHighThreatRiser
        
        if isCommonRiser then
            -- Release if Velocity < 5.0 (Covers staggering/shaking animations)
            local isStationary = root.Velocity.Magnitude < 5.0 
            
            -- Scan for Stun Tags (OPTIMIZED: No GetDescendants Loop)
            local hasStunTag = enemy:FindFirstChild("Stun") or enemy:FindFirstChild("Stunned") or enemy:FindFirstChild("Knocked")
            
            if isStationary or hasStunTag then continue end
        end

        -- [REAL SPEED CALCULATION] fix for FireRiser/RiserHazmat jitter
        if not enemy:GetAttribute("LastPos") then
            enemy:SetAttribute("LastPos", root.Position)
            enemy:SetAttribute("LastTime", tick())
            enemy:SetAttribute("RealSpeed", 0)
        else
            local lastPos = enemy:GetAttribute("LastPos")
            local lastTime = enemy:GetAttribute("LastTime")
            local currTime = tick()
            local timeDelta = currTime - lastTime
            
            if timeDelta > 0.05 then -- Update rate
                local dist = (root.Position - lastPos).Magnitude
                local rSpeed = dist / timeDelta
                enemy:SetAttribute("RealSpeed", rSpeed)
                enemy:SetAttribute("LastPos", root.Position)
                enemy:SetAttribute("LastTime", currTime)
            end
        end
        
        local realSpeed = enemy:GetAttribute("RealSpeed") or 0
        local nameLower = string.lower(enemy.Name)
        local isProblematicEnemy = string.find(nameLower, "riserhazmat") or string.find(nameLower, "fireriser")

        -- [SMART STUN DETECTION]
        -- If it's a "Problematic Enemy" and it is NOT moving (RealSpeed ~ 0), 
        -- we force release it, IGNORING the fake high Velocity (20+) caused by physics jitter.
        if isProblematicEnemy then
            if realSpeed < 5.0 then -- Threshold: If moving slower than 5 studs/s, it's stunned/camping/downed
                continue 
            end
        end

        -- [AUTO EXECUTION DETECTION - GENERAL]
        -- Thay thế check ID thủ công bằng thuật toán hành vi (Heuristic)
        -- Logic: Nếu quái chạy Animation CHẬM (Speed <= 0.85) và ĐỨNG YÊN (Velocity < 5) -> Coi là đang kết liễu -> Bỏ qua
        local isExecuting = false
        if dist3D < 30 then 
            local animator = humanoid:FindFirstChild("Animator")
            if animator then
                local playingTracks = animator:GetPlayingAnimationTracks()
                for _, track in ipairs(playingTracks) do
                    -- Dấu hiệu 1: Animation có tốc độ diễn xuất chậm (Cinematic/Grab)
                    -- (Thông thường đòn đánh là >1.0, chạy là 1.0, nhưng Grab/Execute thường là 0.5 - 0.8)
                    local isCinematicSpeed = (track.Speed <= 0.85 and track.Speed > 0.1)
                    
                    -- Dấu hiệu 2: Tên có từ khóa (Backup phụ trợ)
                    local lowName = string.lower(track.Name)
                    local isSuspiciousName = string.find(lowName, "grab") or string.find(lowName, "exec") or string.find(lowName, "kill") or string.find(lowName, "eat")

                    if isCinematicSpeed or isSuspiciousName then
                        -- Điều kiện quyết định: Quái đang "bận" đứng yên tại chỗ để diễn hoạt cảnh
                        if root.Velocity.Magnitude < 5.0 then
                             isExecuting = true
                             break
                        end
                    end
                end
            end
        end

        if isExecuting then 
            continue -- BỎ QUA QUÁI NÀY (Tự động unlock aim khi quái đang diễn hoạt cảnh chậm)
