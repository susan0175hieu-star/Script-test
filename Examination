    local function checkPartVisibility(part, targetModel, myChar)
        if not part then return false end
        local origin = Camera.CFrame.Position
        local tPos = part.Position
        local direction = (tPos - origin)

        local currentFilter = {myChar, Camera}
        for i = 1, 4 do 
            globalRayParams.FilterDescendantsInstances = currentFilter
            local result = workspace:Raycast(origin, direction, globalRayParams)
            if not result then return true, tPos end
            
            local hit = result.Instance
            local isPartOfChar = hit:IsDescendantOf(targetModel)
            
            local lowerName = string.lower(hit.Name)
            if string.find(lowerName, "shield") or string.find(lowerName, "khiên") then 
                if isPartOfChar then return true, tPos else return false end
            end
            
            if isPartOfChar or hit == part then return true, tPos end
            
            if hit.Transparency > 0.7 or not hit.CanCollide then
                table.insert(currentFilter, hit)
            else
                return false
            end
        end
        return false
    end

                    -- 2. Aim Logic (Optimized)
                    local function getClosestTarget()
    local mousePos = UserInputService:GetMouseLocation()
    local candidates = {}
    local char = LocalPlayer.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local myPos = myRoot.Position

    -- PASS 1: Lightweight Screening (2D Proximity & Status)
    for _, enemy in ipairs(validEnemies) do
        if not enemy or enemy == char then continue end
        local root = enemy:FindFirstChild("HumanoidRootPart")
        local humanoid = nil
        for _, c in ipairs(enemy:GetChildren()) do
            if c:IsA("Humanoid") and c.Health > 0 then
                humanoid = c
                break
            end
        end
        if not humanoid then humanoid = enemy:FindFirstChild("Humanoid") end
        if not root or not humanoid then continue end

        -- Metadata Cache (Consolidated)
        local meta = entityCache[enemy]
        if not meta then
            local targetData = getTargetData(enemy.Name)
            meta = {
                isMutant = targetData and targetData.isMutant or false,
                isBoss = targetData and targetData.isBoss or false,
                isShield = isShieldEntity(enemy),
                elite = targetData and targetData.elite or false
            }
            entityCache[enemy] = meta
        end

        -- Distance & FOV Check
        local dist3D = (myPos - root.Position).Magnitude
        local maxRange = meta.isBoss and 2000 or 400
        if dist3D > maxRange then continue end

        local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
        local isAmbush = (dist3D < 20) -- 360 DEGREEE LOGIC: Detect threats behind/close automatically
        
        -- Filter: Only allow if on screen OR extremely close (360 defense)
        if not (onScreen or isAmbush) then continue end

        local mouseDist = onScreen and (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude or (aimFOV * 2)
        -- FOV Filter: Only applies to enemies outside the Ambush/Danger zone
        if not isAmbush and mouseDist > aimFOV then continue end

        -- Death/State Logic (Strict Filter)
        local isDead = (humanoid.Health <= 0) or (humanoid:GetState() == Enum.HumanoidStateType.Dead)
        
        -- NEW: Downed/Ragdoll Check (Fixes Aiming at Ground)
        local head = enemy:FindFirstChild("Head")
        local headY = head and head.Position.Y or 0
        local rootY = root.Position.Y
        local heightDiff = math.abs(headY - rootY)
        
        -- PRONE MEMORY: Keep them marked as prone for 2.5s if they hit any threshold
        local isCurrentlyProne = humanoid.PlatformStand or 
                                (humanoid:GetState() == Enum.HumanoidStateType.FallingDown) or 
                                (humanoid:GetState() == Enum.HumanoidStateType.Ragdoll) or
                                (humanoid:GetState() == Enum.HumanoidStateType.Physics) or
                                (humanoid.Sit) or (root.CFrame.UpVector.Y < 0.4) or
                                (heightDiff < 0.8) or (enemy:FindFirstChild("Stun") or enemy:FindFirstChild("Stunned"))
        
        if isCurrentlyProne then meta.lastProneTime = tick() end
        local isDowned = (tick() - (meta.lastProneTime or 0) < 0.2) -- Faster recovery: 0.2s
        
        if isDead then continue end -- FORCE RELEASE DEAD TARGETS
        
        if isDowned then
            -- BOSS/SHIELD/ELITE EXEMPTION: Track bosses, shield-enemies, and elites while alive but downed
            -- ADDED: Slasher/FireSlasher exemption to keep lock as normal enemies
            local name = string.lower(enemy.Name)
            local isSlasher = string.find(name, "slasher")
            
            if not (meta.isBoss or meta.isShield or meta.elite or isSlasher) then
                local velocityMag = root.Velocity.Magnitude
                -- If they are downed/ragdolled and not moving extremely fast, skip
                if velocityMag <= 15.0 then continue end
            end
        end

        -- ANCHORED CHECK (With Self-Defense Override)
        -- If < 15 studs, ignore Anchored status (Self Defense Override)
        -- If Elite/Mutant/Boss/Shield, ignore Anchored status
        local isSelfDefense = (dist3D <= 15)
        local name = string.lower(enemy.Name)
        local isSlasher = string.find(name, "slasher")
        local isExempt = meta.isBoss or meta.isShield or meta.elite or meta.isMutant or isSlasher or hasWeapon(enemy)
        
        if root.Anchored and not (isSelfDefense or isExempt) then continue end
        
        table.insert(candidates, {
            model = enemy,
            dist = mouseDist,
            dist3D = dist3D,
            root = root,
            humanoid = humanoid,
            meta = meta,
            isDead = isDead
        })
    end

    -- Sort by PROXIMITY (User Request: "Prioritize all monsters near self first")
    table.sort(candidates, function(a, b) 
        -- TIER 1: DANGER ZONE (< 25 studs) - Absolute Priority
        local aIsDanger = (a.dist3D < 25)
        local bIsDanger = (b.dist3D < 25)
        
        if aIsDanger and not bIsDanger then return true end
        if bIsDanger and not aIsDanger then return false end
        
        if aIsDanger and bIsDanger then
            return a.dist3D < b.dist3D -- If both close, closest wins
        end

        -- TIER 2: STANDARD SCORING (Distance & Mouse Proximity)
        local scoreA = (a.dist3D * 20) + a.dist - (a.meta.isBoss and 300 or 0)
        local scoreB = (b.dist3D * 20) + b.dist - (b.meta.isBoss and 300 or 0)
        
        -- STICKINESS: Maintain target focus
        if a.model == lastTarget then scoreA = scoreA - 50 end
        if b.model == lastTarget then scoreB = scoreB - 50 end

        -- BACKSTAB PRIORITY: Bonus for targets facing away (vulnerable)
        local aIsBack = (a.root.CFrame.LookVector:Dot(Camera.CFrame.LookVector) > 0.5)
        local bIsBack = (b.root.CFrame.LookVector:Dot(Camera.CFrame.LookVector) > 0.5)
        if aIsBack then scoreA = scoreA - 80 end
        if bIsBack then scoreB = scoreB - 80 end

        return scoreA < scoreB
    end)

    -- PASS 2: Heavy Physics (Visibility) on Top Candidates
    globalRayParams.FilterDescendantsInstances = {char, Camera}

    for _, cand in ipairs(candidates) do
        local character = cand.model
        local meta = cand.meta
        
                        -- Check Targets with STICKINESS (Stay on same part if possible)
                        local currentTargetPart = nil
                        local currentLockedPos = nil
                        
                        -- 1. Try to stay on the same part we were already aiming at
                        -- ADDED: If held part is NOT Head, re-check Head/Torso visibility every frame to recover aim
                        if lastTarget == character and lastTargetPart then
                            local heldPart = character:FindFirstChild(lastTargetPart)
                            local head = character:FindFirstChild("Head")
                            
                            -- Always try to "Switch back" to Head if it becomes visible
                            if lastTargetPart ~= "Head" and head then
                                local hVis, hPos = checkPartVisibility(head, character, char, globalRayParams)
                                if hVis then
                                    currentTargetPart, currentLockedPos = head, hPos
                                    lastTargetPart = "Head"
                                end
                            end
                            
                            if not currentTargetPart and heldPart then
                                local vis, pos = checkPartVisibility(heldPart, character, char, globalRayParams)
                                if vis then currentTargetPart, currentLockedPos = heldPart, pos end
                            end
                        end

                        -- 2. If no persistent part or it's hidden, find a new one
                        if not currentTargetPart then
                            local targets = {"Head", "UpperTorso", "HumanoidRootPart"}
                            for _, name in ipairs(targets) do
                                local p = character:FindFirstChild(name)
                                local vis, pos = checkPartVisibility(p, character, char, globalRayParams)
                                if vis then 
                                    currentTargetPart, currentLockedPos = p, pos
                                    lastTargetPart = name -- Save for next frame
                                    break 
                                end
                            end
                        end
                        
                        if not currentTargetPart then
                            local detailParts = {"RightUpperArm", "LeftUpperArm", "RightLowerArm", "LeftLowerArm", "RightLowerLeg", "LeftLowerLeg"}
                            for _, name in ipairs(detailParts) do
                                local part = character:FindFirstChild(name)
                                local vis, pos = checkPartVisibility(part, character, char, globalRayParams)
                                if vis then 
                                    currentTargetPart, currentLockedPos = part, pos
                                    lastTargetPart = name -- Save for next frame
                                    break 
                                end
                            end
                        end
        
        -- Valid Target Found? Return immediately (Snap to it!)
        if currentTargetPart then
            local isFacingAway = (cand.root.CFrame.LookVector:Dot(Camera.CFrame.LookVector) > 0.6)
            
            -- DYNAMIC SHIELD BYPASS: Disable offset if downed OR facing away
            local hum = cand.humanoid
            local root = cand.root
            local head = character:FindFirstChild("Head")
            local hDiff = head and math.abs(head.Position.Y - root.Position.Y) or 5
            
            -- PUSH MEMORY: If spinning (> 5) or pushed (> 15), treat as vulnerable for 0.6s
            if cand.root.RotVelocity.Magnitude > 5 or cand.root.Velocity.Magnitude > 15 then meta.lastPushTime = tick() end
            local isRecentlyPushed = (tick() - (meta.lastPushTime or 0) < 0.6)

            local isCurrentlyProne = hum.PlatformStand or (hum:GetState() == Enum.HumanoidStateType.FallingDown) or (hum:GetState() == Enum.HumanoidStateType.Ragdoll) or (hum:GetState() == Enum.HumanoidStateType.Physics) or (hum.Sit) or (root.CFrame.UpVector.Y < 0.4) or (hDiff < 0.8) or (character:FindFirstChild("Stunned")) or isRecentlyPushed
            if isCurrentlyProne then meta.lastProneTime = tick() end
            
            local isProne = (tick() - (meta.lastProneTime or 0) < 0.2) -- Match recovery time
            local shouldApplyOffset = meta.isShield and not (isProne or isFacingAway)

            -- Persistence Update
            lastTarget = character
            lastTargetTime = tick()

            -- Debug Update removed for production

            return currentTargetPart, currentLockedPos, shouldApplyOffset, cand.root.Velocity, currentTargetPart.Name, meta.isHighMob, isFacingAway, character
        end
    end

    -- PASS 3: Target Persistence (Grace Period for Bosses/Active Targets)
    -- If we lost the target due to teleport/jump, try to find it again for 0.5s
    if lastTarget and lastTarget.Parent and (tick() - lastTargetTime < 0.5) then
        local character = lastTarget
        local root = character:FindFirstChild("HumanoidRootPart")
        local hum = character:FindFirstChildOfClass("Humanoid")
        
        if root and hum and hum.Health > 0 then
            local meta = entityCache[character] or {isBoss = isBossEntity(character)}
            
            -- For bosses, we allow "loose" tracking (check more parts if needed)
            local targets = {"Head", "UpperTorso", "HumanoidRootPart", "LowerTorso", "RightUpperArm", "LeftUpperArm"}
            for _, name in ipairs(targets) do
                local p = character:FindFirstChild(name)
                if p then
                    local vis, pos = checkPartVisibility(p, character, char, globalRayParams)
                    if vis or meta.isBoss then -- Bosses can be tracked even if occluded for 0.5s
                        -- DYNAMIC SHIELD BYPASS (Persistence): Disable offset if downed
                        local headPos = character:FindFirstChild("Head") and character.Head.Position.Y or 0
                        local hDiff = math.abs(headPos - root.Position.Y)
                        -- PUSH MEMORY (Persistence)
                        if root.RotVelocity.Magnitude > 5 or root.Velocity.Magnitude > 15 then meta.lastPushTime = tick() end
                        local isRecentlyPushed = (tick() - (meta.lastPushTime or 0) < 0.6)

                        local isCurrentlyProne = hum.PlatformStand or (hum:GetState() == Enum.HumanoidStateType.FallingDown) or (hum:GetState() == Enum.HumanoidStateType.Ragdoll) or (hum:GetState() == Enum.HumanoidStateType.Physics) or (hum.Sit) or (root.CFrame.UpVector.Y < 0.4) or (hDiff < 0.8) or (character:FindFirstChild("Stunned")) or isRecentlyPushed
                        if isCurrentlyProne then meta.lastProneTime = tick() end
                        
                        local isProne = (tick() - (meta.lastProneTime or 0) < 0.5)
                        local shouldApplyOffset = meta.isShield and not isProne
                        
                        return p, pos or p.Position, shouldApplyOffset, root.Velocity, p.Name, meta.isHighMob, false, character
                    end
                end
            end
        end
    end

    return nil
                    end

    -- 3. Aim Loop
