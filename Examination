    local function IsVisible(target, part)
        if not wallCheckEnabled then return true end
        local origin = Camera.CFrame.Position
        local direction = part.Position - origin
        local params = RaycastParams.new()
        params.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.IgnoreWater = true
        local result = workspace:Raycast(origin, direction, params)
        if not result then return true end
        if result.Instance:IsDescendantOf(target) then return true end
        return false
    end

    local function IsExecuting(humanoid, rootPart)
        if not ignoreExecution or not humanoid then return false end
        
        -- Stun/Downed Check (Restored)
        -- Stun/Downed Check REMOVED to allow juggling/shooting ragdolls
        if humanoid.PlatformStand or humanoid:GetState() == Enum.HumanoidStateType.Physics or humanoid:GetState() == Enum.HumanoidStateType.FallingDown then
        return true
        end

        local animator = humanoid:FindFirstChild("Animator")
        if animator then
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                -- Strict Check: Must be playing
                if track.IsPlaying then
                    -- Safe Weight Check (Prevent Crash on 'Weight' property)
                    local weight = 1
                    local success, w = pcall(function() return track.WeightCurrent end)
                    if success and w then weight = w end
                    
                    -- Check if animation is playing with HIGH weight (ignore fading animations)
                    if weight > 0.85 then
                        local animName = string.lower(track.Animation.Name)
                        for _, keyword in ipairs(IgnoredAnimKeywords) do
                            if string.find(animName, keyword) then return true end
                        end
                        local idNum = string.match(track.Animation.AnimationId, "%d+")
                        for _, badId in ipairs(IgnoredAnimIDs) do
                            if idNum == badId then return true end
                        end
                    end
                end
            end
        end
        return false
    end

    getClosestTarget = function() 
        local bestTarget = nil
        local shortestDistance = math.huge
        local mousePos = UserInputService:GetMouseLocation()
        
        local char = LocalPlayer.Character
        for _, enemy in ipairs(validEnemies) do
            if not enemy or enemy == char then continue end
            
            local hum = enemy:FindFirstChildOfClass("Humanoid")
            local root = enemy:FindFirstChild("HumanoidRootPart")
            if not hum or not root or hum.Health <= 0 then continue end
            
            local head = enemy:FindFirstChild("Head")
            local root = enemy:FindFirstChild("HumanoidRootPart")
            local torso = enemy:FindFirstChild("UpperTorso") or enemy:FindFirstChild("Torso")
            
            if not head and not root then continue end

            -- [ OPTIMIZATION ] Distance Check FIRST (Cheapest check)
            if (root.Position - Camera.CFrame.Position).Magnitude > Settings.MaxDistance then 
                continue 
            end

            -- [ HEAVY CHECK ] Only check animations if within range
            if IsExecuting(hum, root) then continue end

            -- Check Head First
            local targetPart = head or root
            local vector, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
            local isVis = false
            
            if onScreen then
                local screenPoint = Vector2.new(vector.X, vector.Y)
                local dist = (screenPoint - mousePos).Magnitude
                
                if dist <= (aimFOV or 450) then
                    -- Multi-Point Visibility Check (Head -> Torso -> Root)
                    if IsVisible(enemy, targetPart) then
                        isVis = true
                    elseif torso and IsVisible(enemy, torso) then
                        isVis = true
                        targetPart = torso
                    elseif root and targetPart ~= root and IsVisible(enemy, root) then
                        -- Fallback to Root
                        isVis = true
                        targetPart = root 
                    end

                    if isVis then
                        if dist < shortestDistance then
                            shortestDistance = dist
                            bestTarget = enemy
                        end
                    end
                end
            end
        end
        return bestTarget
    end

