                    if root and root.Anchored and Camera.CameraType == Enum.CameraType.Scriptable then
                        return -- Đây là finisher animation, skip
                    end
                end
                
                -- Check if label is near screen center (standard for QTEs)
                local screenCenter = Camera.ViewportSize / 2
                local pos = textLabel.AbsolutePosition + (textLabel.AbsoluteSize / 2)
                local distFromCenter = (pos - screenCenter).Magnitude
                
                if distFromCenter < 500 then
                    local txt = textLabel.Text:upper():gsub("[%[%]%s+]", "") -- Clean brackets and spaces
                    if #txt == 1 and txt:match("[A-Z]") then
                        -- Ensure it's not hidden by parent visibility
                        local isVisible = true
                        local p = textLabel.Parent
                        while p and p:IsA("GuiObject") do
                            if not p.Visible then isVisible = false break end
                            p = p.Parent
                        end
                        
                        if isVisible then
                            local key = Enum.KeyCode[txt]
                            if key then
                                -- Debounce
                                if not getgenv().qteDebounce then getgenv().qteDebounce = {} end
                                local now = tick()
                                if not getgenv().qteDebounce[key] or (now - getgenv().qteDebounce[key] > 0.15) then
                                    getgenv().qteDebounce[key] = now
                                    
                                    -- ✅ Small delay to let animation stabilize
                                    task.wait(0.05)
                                    
                                    VirtualInputManager:SendKeyEvent(true, key, false, game)
                                    task.wait(0.01)
                                    VirtualInputManager:SendKeyEvent(false, key, false, game)
                                end
                            end
                        end
                    end
                end
            end)
        end
        
