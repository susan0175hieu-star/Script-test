local function isShieldEntity(model)
    if not model then return false end
    for _, child in ipairs(model:GetDescendants()) do
        if child:IsA("BasePart") or child:IsA("Model") then
            local cn = string.lower(child.Name)
            if string.find(cn, "shield") or string.find(cn, "riot") then 
                -- Ignore face shield/glass
                if not (string.find(cn, "face") or string.find(cn, "glass")) then
                    return true 
                end
            end
        end
    end
    return false
end
-- HELPER: Check if Player is Infected (Moved Up)
local function isPlayerInfected(plr)
    if not plr then return false end

    -- 1. TEAM CHECK
    local team = plr.Team
    if team then
        local tn = string.lower(team.Name)
        if string.find(tn, "infect") or string.find(tn, "monster") or string.find(tn, "zombie") or string.find(tn, "vật thí nghiệm") then
            return true
        end
    end

    -- 2. TOOL/MARKER CHECK
    local char = plr.Character
    if char then
        local cName = string.lower(char.Name)
        if string.find(cName, "classless") or string.find(cName, "viral") then return true end

        if char:FindFirstChild("Infected") or char:FindFirstChild("Claw") or char:FindFirstChild("Bite") then return true end
        -- Recursive tool check for "Claw", "Bite", or known Infected Weapons
        for _, child in ipairs(char:GetChildren()) do
            if child:IsA("Tool") or child:IsA("Model") then -- Some weapons might be Models
                local n = string.lower(child.Name)
                if n == "claw" or n == "bite" or n == "infect" or n == "attack" or n == "viralmaul" or n == "beanbag" or n == "mp5infected" then return true end
            end
        end
    end

    return false
end

